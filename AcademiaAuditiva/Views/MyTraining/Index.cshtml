@{
    ViewData["Title"] = Localizer["MyTraining.Title"].Value;
    var classrooms = (List<AcademiaAuditiva.Controllers.MyClassroomRow>)ViewBag.Classrooms;
    var assignments = (List<AcademiaAuditiva.Controllers.MyRoutineAssignmentRow>)ViewBag.Assignments;
}

<header class="mb-4">
    <h1 class="display-6 mb-1 text-body-emphasis">@Localizer["MyTraining.Title"]</h1>
    <p class="text-secondary mb-0">@Localizer["MyTraining.Subtitle"]</p>
</header>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="aa-card-flat h-100">
            <div class="p-3 border-bottom border-body d-flex align-items-center gap-2">
                <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-people"></i></span>
                <strong class="text-body-emphasis">@Localizer["MyTraining.MyClassrooms"]</strong>
            </div>
            @if (!classrooms.Any())
            {
                <div class="p-3 text-secondary small">
                    @Localizer["MyTraining.NoClassrooms"]
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var c in classrooms)
                    {
                        <li class="list-group-item bg-transparent">
                            <div class="fw-semibold text-body-emphasis">@c.Name</div>
                            <small class="text-secondary">@Localizer["MyTraining.Teacher"]: @c.TeacherDisplay · @Localizer["MyTraining.Joined"] @c.JoinedAt.ToString("yyyy-MM-dd")</small>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="aa-card-flat h-100">
            <div class="p-3 border-bottom border-body d-flex align-items-center gap-2">
                <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-list-check"></i></span>
                <strong class="text-body-emphasis">@Localizer["MyTraining.MyRoutines"]</strong>
            </div>
            @if (!assignments.Any())
            {
                <div class="p-3 text-secondary small">@Localizer["MyTraining.NoRoutines"]</div>
            }
            else
            {
                <div class="p-3">
                    @foreach (var a in assignments)
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <strong class="text-body-emphasis">@a.RoutineName</strong>
                                    <span class="aa-badge-soft ms-2">
                                        @if (a.ClassroomName != null) { <text>@Localizer["MyTraining.Source.Classroom", a.ClassroomName]</text> }
                                        else { <text>@Localizer["MyTraining.Source.Personal"]</text> }
                                    </span>
                                </div>
                                <small class="text-secondary">
                                    @if (a.DueAt.HasValue) { <text>@Localizer["MyTraining.Due"] @a.DueAt.Value.ToString("yyyy-MM-dd")</text> }
                                    else { <text>@Localizer["MyTraining.NoDeadline"]</text> }
                                </small>
                            </div>
                            <div class="progress my-2" role="progressbar" aria-label="@a.RoutineName" aria-valuenow="@a.OverallPercent" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                                <div class="progress-bar" style="width: @(a.OverallPercent)%;"></div>
                            </div>
                            <ul class="list-group list-group-flush small">
                                @foreach (var i in a.Items)
                                {
                                    var p = i.Progress;
                                    var href = Url.Action(i.ExerciseName, "Exercise", new Microsoft.AspNetCore.Routing.RouteValueDictionary(i.Filters.ToDictionary(kv => kv.Key, kv => (object?)kv.Value)))
                                               ?? Url.Action("Index", "Exercise");
                                    <li class="list-group-item bg-transparent px-0 border-0 aa-routine-item">
                                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                            <a class="text-body link-offset-2 fw-semibold" href="@href">
                                                @if (p.IsComplete) { <i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i> }
                                                @i.DisplayName
                                            </a>
                                            <span class="text-secondary text-nowrap">
                                                @if (p.IsComplete) { <span class="visually-hidden">@Localizer["MyTraining.Complete"]: </span> }
                                                @p.Done / @p.Target (@(p.Percent)%)
                                            </span>
                                        </div>
                                        @if (i.AppliedFilters.Count > 0 || p.MinScore.HasValue)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                                @foreach (var f in i.AppliedFilters)
                                                {
                                                    <span class="aa-badge-soft">@Localizer[f.Group.Label]: @Localizer[f.Option.Text]</span>
                                                }
                                                @if (p.MinScore.HasValue)
                                                {
                                                    <span class="@(p.Accuracy.HasValue && !p.MeetsMinScore ? "text-danger" : "text-secondary")">
                                                        @if (p.Accuracy.HasValue) { <text>@Localizer["MyTraining.AccuracyMin", p.Accuracy.Value, p.MinScore.Value]</text> }
                                                        else { <text>@Localizer["MyTraining.MinAccuracy", p.MinScore.Value]</text> }
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </li>
                                }
                                @if (!a.Items.Any())
                                {
                                    <li class="list-group-item bg-transparent text-secondary px-0 border-0">@Localizer["MyTraining.NoExercises"]</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
