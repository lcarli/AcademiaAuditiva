@using System.Globalization
@using Microsoft.AspNetCore.Builder
@using Microsoft.Extensions.Options
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var currentUiCulture = CultureInfo.CurrentUICulture;
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
    var cultures = LocOptions.Value.SupportedUICultures ?? new List<CultureInfo>();

    static string DisplayName(CultureInfo culture) =>
        string.IsNullOrEmpty(culture.NativeName)
            ? culture.Name
            : char.ToUpper(culture.NativeName[0], culture) + culture.NativeName[1..];
}

<form asp-area="" asp-controller="Dashboard" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="dropdown">
    <button class="aa-lang-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
            aria-label="@Localizer["Layout.Language"]: @DisplayName(currentUiCulture)" title="@Localizer["Layout.Language"]">
        @currentUiCulture.TwoLetterISOLanguageName.ToUpperInvariant()
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var culture in cultures)
        {
            var isCurrent = string.Equals(culture.Name, currentUiCulture.Name, StringComparison.OrdinalIgnoreCase);
            <li>
                <button type="submit" name="culture" value="@culture.Name" lang="@culture.Name"
                        class="dropdown-item @(isCurrent ? "active" : null)" aria-current="@(isCurrent ? "true" : null)">
                    @DisplayName(culture)
                </button>
            </li>
        }
    </ul>
</form>