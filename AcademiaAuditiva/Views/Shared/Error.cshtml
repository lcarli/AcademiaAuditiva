@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error.Title"].Value;
}

<h1 class="text-danger">@Localizer["Error.Title"]</h1>
<h2 class="text-danger">@Localizer["Error.Message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["Error.DevelopmentMode"]</h3>
<p>
    @Html.Raw(string.Format(Localizer["Error.DevelopmentModeInfo"].Value, "<strong>Development</strong>"))
</p>
<p>
    <strong>@Localizer["Error.DevelopmentModeWarning"]</strong>
    @Html.Raw(string.Format(Localizer["Error.DevelopmentModeDebug"].Value, "<strong>ASPNETCORE_ENVIRONMENT</strong>", "<strong>Development</strong>"))
</p>
