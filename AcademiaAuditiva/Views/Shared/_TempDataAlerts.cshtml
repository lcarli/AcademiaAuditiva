@* Flash messages set by controllers through TempData["Success"] / TempData["Error"].
   Rendered once by the area layouts (and pages outside an area that redirect with a message),
   never by _Layout as well, or every message shows twice. *@
@if (TempData["Success"] is string success && !string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2" role="status" data-aa-autodismiss="6000">
        <i class="bi bi-check-circle mt-1" aria-hidden="true"></i>
        <div>@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"].Value"></button>
    </div>
}
@if (TempData["Error"] is string error && !string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>
        <div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"].Value"></button>
    </div>
}
