@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Antiforgery
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var currentArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    bool IsCurrent(string area, string? controller = null) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
        && (controller is null || string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewBag.Title - Academia Auditiva</title>
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0B12" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script>
        // Theme bootstrap — runs before CSS paints to prevent FOUC.
        // Priority: saved preference > system (prefers-color-scheme) > light.
        (function () {
            try {
                var saved = localStorage.getItem('aa-theme');
                var theme;
                if (saved === 'dark' || saved === 'light') {
                    theme = saved;
                } else {
                    theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { document.documentElement.setAttribute('data-bs-theme', 'light'); }
        })();
    </script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            // Practice streaks count the player's calendar days, so the server needs the
            // browser's time zone (read by UserTimeZone; listed in the privacy policy).
            (function () {
                try {
                    var zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                    if (!zone) return;
                    var cookie = '@(AcademiaAuditiva.Services.Gamification.UserTimeZone.CookieName)=' + encodeURIComponent(zone);
                    if (document.cookie.split('; ').indexOf(cookie) !== -1) return;
                    document.cookie = cookie + '; path=/; max-age=31536000; samesite=lax' + (location.protocol === 'https:' ? '; secure' : '');
                } catch (e) { }
            })();
        </script>
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.1/css/bootstrap.min.css"
          integrity="sha512-Z/def5z5u2aR89OuzYcxmDJ0Bnd5V1cKqBEbvLOiUNWdg9PQeXVvXLI90SE4QOHGlfLqUnDNVAYyZi8UwUTmWQ=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.min.css"
          integrity="sha384-vBnv27bYSGJRQPyi/b5+ZvSHCIfEOf/uBVxgFtuoVFUemjwF5hGt/AeK+XXJFVyA"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    @* SweetAlert2 10.16.10+ ships protestware (plays audio and blocks the page on .ru domains); stay on 10.16.9. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10.16.9/dist/sweetalert2.min.css"
          integrity="sha384-xlHFsCasw2aJoI2zbyEfOrOdeZGWWDduVXC48pzXU4bdPRpKrkuhgEqtwX4oudAK"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/aa-design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        [x-cloak] { display: none !important; }
        .htmx-indicator { opacity: 0; transition: opacity 200ms ease-in; }
        .htmx-request .htmx-indicator { opacity: 1; }
    </style>
</head>

<body hx-indicator="#htmx-progress">
    <a href="#mainContent" class="aa-skip-link">@Localizer["Layout.SkipToMain"]</a>
    <div id="htmx-progress" class="htmx-indicator aa-htmx-progress" aria-hidden="true"></div>

    <header>
        <nav class="navbar navbar-expand-lg aa-navbar sticky-top">
            <div class="container-xl">
                <a class="navbar-brand aa-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Logo" />
                    <span class="aa-brand-text">Academia Auditiva</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="@Localizer["Layout.ToggleNav"]">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("", "Dashboard") ? "active" : null)" aria-current="@(IsCurrent("", "Dashboard") ? "page" : null)"
                                   asp-area="" asp-controller="Dashboard" asp-action="Index">@Localizer["Header.Dashboard"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("", "LearningPath") ? "active" : null)" aria-current="@(IsCurrent("", "LearningPath") ? "page" : null)"
                                   asp-area="" asp-controller="LearningPath" asp-action="Index">@Localizer["Header.LearningPath"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("", "Exercise") ? "active" : null)" aria-current="@(IsCurrent("", "Exercise") ? "page" : null)"
                                   asp-area="" asp-controller="Exercise" asp-action="Index" data-tour="nav-exercises">@Localizer["Header.Exercise"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("", "Explore") ? "active" : null)" aria-current="@(IsCurrent("", "Explore") ? "page" : null)"
                                   asp-area="" asp-controller="Explore" asp-action="Index">@Localizer["Header.Explore"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsCurrent("", "MyTraining") ? "active" : null)" aria-current="@(IsCurrent("", "MyTraining") ? "page" : null)"
                                   asp-area="" asp-controller="MyTraining" asp-action="Index" data-tour="nav-training">@Localizer["Header.MyTraining"]</a>
                            </li>
                            @if (User.IsInRole(AcademiaAuditiva.Models.RoleNames.Teacher) || User.IsInRole(AcademiaAuditiva.Models.RoleNames.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsCurrent("Teacher") ? "active" : null)" aria-current="@(IsCurrent("Teacher") ? "page" : null)"
                                       asp-area="Teacher" asp-controller="Home" asp-action="Index">@Localizer["Header.Teacher"]</a>
                                </li>
                            }
                            @if (User.IsInRole(AcademiaAuditiva.Models.RoleNames.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsCurrent("Admin") ? "active" : null)" aria-current="@(IsCurrent("Admin") ? "page" : null)"
                                       asp-area="Admin" asp-controller="Home" asp-action="Index">@Localizer["Header.Admin"]</a>
                                </li>
                            }
                        </ul>
                    }

                    <div class="d-flex ms-auto align-items-center gap-2 flex-wrap">
                        @await Html.PartialAsync("_SelectLanguagePartial")
                        <button id="themeToggle" type="button" class="aa-theme-toggle" aria-label="@Localizer["Layout.ToggleTheme"]" title="@Localizer["Layout.ToggleTheme"]">
                            <i class="bi bi-moon-stars" aria-hidden="true"></i>
                        </button>
                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="mainContent" class="container-xl my-4" role="main">
        @await Html.PartialAsync("_TempDataAlerts")
        @RenderBody()
    </main>

    <footer class="aa-footer">
        <div class="container-xl">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6">
                    <a class="aa-brand mb-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <partial name="_Logo" />
                        <span class="aa-brand-text">Academia Auditiva</span>
                    </a>
                    <small class="d-block">@Localizer["Layout.FooterTagline"]</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="d-block mb-1">&copy; @DateTime.Now.Year Academia Auditiva</small>
                    <small>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Layout.Privacy"]</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"
            integrity="sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // Anti-forgery token injection: every same-origin POST/PUT/DELETE/PATCH
        // fetch() picks up the request-verification-token meta automatically,
        // so existing JS in wwwroot/js/Exercises/* keeps working under the
        // global AutoValidateAntiforgeryToken filter without per-call changes.
        (function () {
            var meta = document.querySelector('meta[name="request-verification-token"]');
            if (!meta) return;
            var token = meta.getAttribute('content') || '';
            var unsafe = { POST: 1, PUT: 1, DELETE: 1, PATCH: 1 };
            var origFetch = window.fetch.bind(window);
            window.fetch = function (input, init) {
                init = init || {};
                var method = (init.method || (typeof input !== 'string' && input && input.method) || 'GET').toUpperCase();
                if (!unsafe[method]) return origFetch(input, init);
                var url = typeof input === 'string' ? input : (input && input.url) || '';
                var sameOrigin = url.startsWith('/') || url.startsWith(window.location.origin);
                if (!sameOrigin) return origFetch(input, init);
                var headers = new Headers(init.headers || {});
                if (!headers.has('RequestVerificationToken')) headers.set('RequestVerificationToken', token);
                init.headers = headers;
                return origFetch(input, init);
            };
        })();
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.8/umd/popper.min.js"
            integrity="sha512-TPh2Oxlg1zp+kz3nFA0C5vVC6leG/6mm1z9+mA81MI5eaUVqasPLO8Cuk4gMF4gUfP5etR73rgU/8PNMsSesoQ=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.1/js/bootstrap.min.js"
            integrity="sha512-fHY2UiQlipUq0dEabSM4s+phmn+bcxSYzXP4vAXItBvBHU7zAM/mkhCZjtBEIJexhOMzZbgFlPLuErlJF2b+0g=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/htmx.org@2.0.3"
            integrity="sha384-0895/pl2MU10Hqc6jd4RvrthNlDiE9U1tWmX7WRESftEDRosgxNsQG/Ze9YMRzHq"
            crossorigin="anonymous"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js"
            integrity="sha384-l8f0VcPi/M1iHPv8egOnY/15TDwqgbOR1anMIJWvU6nLRgZVLTLSaNqi/TOoT5Fh"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10.16.9/dist/sweetalert2.min.js"
            integrity="sha384-GjzHyTYR8FCw50srE7hggd4Tlqw3oq9apyk/Gtq815HMWyf38e1yZ7A4KvtL71Xw"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/core/audio-engine.js" asp-append-version="true"></script>
    <script src="~/js/core/i18n.js" asp-append-version="true"></script>
    <script src="~/js/core/rewards.js" asp-append-version="true"></script>
    <script src="~/js/core/alerts.js" asp-append-version="true"></script>
    <script src="/js/games/game-engine.js?v=1.0.2"></script>
    <script src="/js/main/academia-auditiva.js?v=1.0.2"></script>
    <script src="/js/AcademiaAuditiva.Filters.js?v=1.0.2"></script>
    <script>
        // Theme toggle: persists choice in localStorage, follows system if no choice saved.
        (function () {
            var html = document.documentElement;
            var btn = document.getElementById('themeToggle');
            var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

            function paint() {
                var icon = btn && btn.querySelector('i');
                if (!icon) return;
                icon.className = html.getAttribute('data-bs-theme') === 'dark'
                    ? 'bi bi-sun' : 'bi bi-moon-stars';
            }
            paint();

            if (btn) {
                btn.addEventListener('click', function () {
                    var next = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                    html.setAttribute('data-bs-theme', next);
                    localStorage.setItem('aa-theme', next);
                    paint();
                });
            }

            // Live-follow system preference when user has not set an explicit choice.
            if (media && media.addEventListener) {
                media.addEventListener('change', function (e) {
                    if (localStorage.getItem('aa-theme')) return;
                    html.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light');
                    paint();
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
