@using System.Globalization
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Localizer["Home.PageTitle"].Value;
    var signedIn = User.Identity?.IsAuthenticated == true;

    var noteHead = new HtmlString("<svg class=\"aa-notehead\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><ellipse cx=\"8\" cy=\"8\" rx=\"6\" ry=\"4.4\" transform=\"rotate(-22 8 8)\"/></svg>");
    // SVG coordinates must not use the request culture's decimal comma.
    string N(double v) => v.ToString(CultureInfo.InvariantCulture);

    var staffNotes = new[] { (X: 70, Y: 116, Accent: false), (X: 120, Y: 100, Accent: false), (X: 170, Y: 108, Accent: true), (X: 220, Y: 84, Accent: false), (X: 268, Y: 92, Accent: false) };
    var features = new[] { 1, 2, 3 };
    var steps = new[] { 1, 2, 3 };
    var exercises = new[] { "GuessNote", "GuessInterval", "GuessFullInterval", "IntervalMelodico", "GuessChords", "GuessQuality", "GuessFunction", "GuessMissingNote", "SolfegeMelody" };
    var roles = new[]
    {
        (Id: "student", Tab: "Home.Roles.TabStudent", Prefix: "Home.Roles.Student", Note: (string?)null),
        (Id: "teacher", Tab: "Home.Roles.TabTeacher", Prefix: "Home.Roles.Teacher", Note: (string?)"Home.Roles.TeacherNote")
    };
}

<section class="aa-hero" aria-labelledby="aa-hero-title">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <span class="aa-eyebrow">@Localizer["Home.Hero.Eyebrow"]</span>
            <h1 id="aa-hero-title" class="aa-hero-title">@Localizer["Home.Hero.Title"]</h1>
            <p class="lead mb-0">@Localizer["Home.Hero.Lead"]</p>
            <div class="aa-hero-ctas">
                @if (signedIn)
                {
                    <a class="btn btn-primary btn-lg px-4" asp-area="" asp-controller="Exercise" asp-action="Index">@Localizer["Home.Cta.GoToExercises"]</a>
                    <a class="btn btn-lg aa-ghost-btn px-4" asp-area="" asp-controller="Dashboard" asp-action="Index">@Localizer["Home.Cta.MyProgress"]</a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg px-4" asp-area="Identity" asp-page="/Account/Register">@Localizer["Home.Cta.Start"]</a>
                    <a class="btn btn-lg aa-ghost-btn px-4" href="#how-it-works">@Localizer["Home.Cta.HowItWorks"]</a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <svg class="aa-staff aa-hero-art" viewBox="0 30 300 104" aria-hidden="true" focusable="false">
                @for (var i = 0; i < 5; i++)
                {
                    var y = 60 + i * 16;
                    <line class="aa-staff-line" x1="0" x2="300" y1="@y" y2="@y" />
                }
                @foreach (var note in staffNotes)
                {
                    <g class="@(note.Accent ? "aa-staff-note-accent" : "aa-staff-note")">
                        <ellipse cx="@note.X" cy="@note.Y" rx="9" ry="6.5" transform="rotate(-22 @note.X @note.Y)" />
                        <rect x="@N(note.X + 7.2)" y="@(note.Y - 44)" width="2" height="44" />
                    </g>
                }
            </svg>
        </div>
    </div>

    <ul class="row g-3 list-unstyled mb-0 mt-4 mt-lg-5">
        @foreach (var i in features)
        {
            <li class="col-md-4">
                <div class="aa-feature">
                    <h2 class="aa-feature-title">@noteHead @Localizer[$"Home.Feature{i}.Title"]</h2>
                    <p>@Localizer[$"Home.Feature{i}.Desc"]</p>
                </div>
            </li>
        }
    </ul>
</section>

<section id="how-it-works" class="aa-section" aria-labelledby="aa-how-title">
    <div class="aa-section-head">
        <span class="aa-eyebrow">@Localizer["Home.How.Badge"]</span>
        <h2 id="aa-how-title" class="aa-section-title">@Localizer["Home.How.Title"]</h2>
        <p>@Localizer["Home.How.Lead"]</p>
    </div>
    <ol class="row g-4 list-unstyled mb-0">
        @foreach (var i in steps)
        {
            <li class="col-md-4">
                <div class="aa-step">
                    <span class="aa-step-num" aria-hidden="true">@i</span>
                    <div>
                        <h3 class="aa-step-title">@Localizer[$"Home.How.Step{i}.Title"]</h3>
                        <p>@Localizer[$"Home.How.Step{i}.Desc"]</p>
                    </div>
                </div>
            </li>
        }
    </ol>
</section>

<section class="aa-section" aria-labelledby="aa-ex-title">
    <div class="aa-section-head">
        <span class="aa-eyebrow">@Localizer["Home.Exercises.Badge"]</span>
        <h2 id="aa-ex-title" class="aa-section-title">@Localizer["Home.Exercises.Title"]</h2>
        <p>@Localizer["Home.Exercises.Lead"]</p>
    </div>
    <ul class="aa-ex-list">
        @foreach (var name in exercises)
        {
            <li>
                <a class="aa-ex-item" asp-area="" asp-controller="Exercise" asp-action="@name">
                    @noteHead
                    <span>
                        <span class="aa-ex-item-title">@Localizer[name]</span>
                        <span class="aa-ex-item-sub">@Localizer[$"Exercise.{name}.Subtitle"]</span>
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="aa-section" aria-labelledby="aa-roles-title"
         x-data="{ tab: 'student', toggle() { this.tab = this.tab === 'student' ? 'teacher' : 'student'; this.$nextTick(() => this.$refs[this.tab].focus()); } }">
    <div class="aa-section-head">
        <span class="aa-eyebrow">@Localizer["Home.Roles.Badge"]</span>
        <h2 id="aa-roles-title" class="aa-section-title">@Localizer["Home.Roles.Title"]</h2>
    </div>

    <div class="aa-pill-tab" role="tablist" aria-labelledby="aa-roles-title">
        @foreach (var role in roles)
        {
            var first = role.Id == "student";
            <button type="button" role="tab" id="aa-tab-@role.Id" aria-controls="aa-panel-@role.Id"
                    aria-selected="@(first ? "true" : "false")" tabindex="@(first ? "0" : "-1")"
                    x-ref="@role.Id"
                    x-bind:aria-selected="tab === '@role.Id'"
                    x-bind:tabindex="tab === '@role.Id' ? 0 : -1"
                    x-on:click="tab = '@role.Id'"
                    x-on:keydown.left.prevent="toggle()"
                    x-on:keydown.right.prevent="toggle()">
                @Localizer[role.Tab]
            </button>
        }
    </div>

    @foreach (var role in roles)
    {
        var first = role.Id == "student";
        <div id="aa-panel-@role.Id" class="aa-roles-panel" role="tabpanel" aria-labelledby="aa-tab-@role.Id" tabindex="0"
             x-show="tab === '@role.Id'" x-cloak="@(first ? null : string.Empty)">
            <ul class="aa-note-list">
                @for (var i = 1; i <= 3; i++)
                {
                    <li>
                        <strong class="d-block text-body-emphasis">@Localizer[$"{role.Prefix}{i}.Title"]</strong>
                        <span class="text-secondary">@Localizer[$"{role.Prefix}{i}.Desc"]</span>
                    </li>
                }
            </ul>
            @if (role.Note is not null)
            {
                <p class="small text-secondary mt-4 mb-0">@Localizer[role.Note]</p>
            }
        </div>
    }
</section>

<section class="aa-section" aria-labelledby="aa-faq-title">
    <div class="row g-4 g-lg-5">
        <div class="col-lg-4">
            <div class="aa-section-head mb-0">
                <span class="aa-eyebrow">@Localizer["Home.Faq.Badge"]</span>
                <h2 id="aa-faq-title" class="aa-section-title">@Localizer["Home.Faq.Title"]</h2>
                <p>@Localizer["Home.Faq.Lead"]</p>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="accordion accordion-flush aa-faq" id="aaFaq">
                @for (var i = 1; i <= 6; i++)
                {
                    var open = i == 1;
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button @(open ? null : "collapsed")" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#aaFaq-@i" aria-expanded="@(open ? "true" : "false")" aria-controls="aaFaq-@i">
                                @Localizer[$"Home.Faq{i}.Q"]
                            </button>
                        </h3>
                        <div id="aaFaq-@i" class="accordion-collapse collapse @(open ? "show" : null)" data-bs-parent="#aaFaq">
                            <div class="accordion-body">@Localizer[$"Home.Faq{i}.A"]</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="aa-final" aria-labelledby="aa-final-title">
    <h2 id="aa-final-title" class="aa-final-title">@Localizer["Home.Final.Title"]</h2>
    <p>@Localizer[signedIn ? "Home.Final.LeadSignedIn" : "Home.Final.Lead"]</p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        @if (signedIn)
        {
            <a class="btn btn-primary btn-lg px-4" asp-area="" asp-controller="Exercise" asp-action="Index">@Localizer["Home.Cta.GoToExercises"]</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg px-4" asp-area="Identity" asp-page="/Account/Register">@Localizer["Home.Cta.SignUpFree"]</a>
            <a class="btn btn-lg aa-ghost-btn px-4" asp-area="Identity" asp-page="/Account/Login">@Localizer["Home.Cta.HaveAccount"]</a>
        }
    </div>
</section>
