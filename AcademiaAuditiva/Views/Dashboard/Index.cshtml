@using AcademiaAuditiva.Services.Gamification
@model GamificationProfile?
@inject Microsoft.Extensions.Localization.IStringLocalizer<AcademiaAuditiva.Resources.SharedResources> S
@{
    ViewBag.Title = Localizer["Dashboard.Title"].Value;

    // French uses the singular for 0 and 1 ("0 jour"); English and Portuguese only for 1.
    string Days(int count)
    {
        var singular = count == 1
            || (count == 0 && System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr");
        return S[singular ? "Gamification.StreakDaysOne" : "Gamification.StreakDaysOther", count].Value;
    }
}

<partial name="_TempDataAlerts" />

<header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <span class="aa-eyebrow">@Localizer["Dashboard.Title"]</span>
        <h1 class="display-6 mt-2 mb-1 text-body-emphasis">
            @Localizer["Dashboard.WelcomeMessage"] <span class="aa-accent-text">@ViewBag.FirstName</span>!
        </h1>
        <p class="text-secondary mb-0">@Localizer["Dashboard.Subtitle"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @* tutorial.js shows the button once it can run the tour. *@
        <button type="button" class="btn btn-outline-secondary" data-aa-tour-start hidden>
            <i class="bi bi-question-circle me-2" aria-hidden="true"></i>@Localizer["Tutorial.Replay"]
        </button>
        <a class="btn btn-primary" asp-controller="Exercise" asp-action="Index">
            <i class="bi bi-play-circle me-2" aria-hidden="true"></i>@Localizer["Dashboard.StartTraining"]
        </a>
    </div>
</header>

@await Component.InvokeAsync("Tutorial", new { key = AcademiaAuditiva.Services.Tutorials.TutorialCatalog.Dashboard })

@if (ViewBag.LearningPath is AcademiaAuditiva.Services.LearningPath.LearningPathProgress { TotalSteps: > 0 } learningPath)
{
    <partial name="_LearningPathCard" model="learningPath" />
}

@if (ViewBag.DailyChallenge is AcademiaAuditiva.Services.DailyChallenge.DailyChallengeProgress { Items.Count: > 0 } dailyChallenge)
{
    <partial name="_DailyChallengeCard" model="dailyChallenge" />
}

@if (Model is { } profile)
{
    var progress = profile.Progress;
    var streak = progress.Streak;
    var latestBadges = profile.LatestEarned(6);
    <section class="mb-4" aria-labelledby="aa-progress-title">
        <h2 id="aa-progress-title" class="visually-hidden">@Localizer["Gamification.ProgressTitle"]</h2>
        @* The tour frames the cards together: the row's gutter would leave a gap above them. *@
        <div class="row row-cols-1 row-cols-lg-3 g-4">
            <div class="col">
                <div class="aa-card p-4 h-100" data-tour="progress">
                    <div class="d-flex align-items-center gap-3">
                        <span class="aa-rank" aria-hidden="true">@progress.Rank</span>
                        <div>
                            <h3 class="h6 text-uppercase small text-secondary mb-1">@Localizer[$"Gamification.Rank.{progress.Rank}"]</h3>
                            <p class="h3 fw-bold mb-0 text-body-emphasis">@Localizer["Gamification.Level", progress.Level]</p>
                        </div>
                    </div>
                    <div class="progress aa-xp-bar mt-4" role="progressbar"
                         aria-label="@S["Gamification.XpToNext", progress.XpToNextLevel, progress.Level + 1]"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.LevelPercent">
                        <div class="progress-bar" style="width: @(progress.LevelPercent)%"></div>
                    </div>
                    <p class="small text-secondary mt-2 mb-0">
                        <span class="fw-semibold text-body-emphasis">@progress.Xp XP</span>
                        · @Localizer["Gamification.XpToNext", progress.XpToNextLevel, progress.Level + 1]
                    </p>
                </div>
            </div>
            <div class="col">
                <div class="aa-card p-4 h-100" data-tour="progress">
                    <div class="d-flex align-items-center gap-3">
                        <span class="aa-icon-pill aa-icon-pill-warm" aria-hidden="true"><i class="bi bi-fire"></i></span>
                        <div>
                            <h3 class="h6 text-uppercase small text-secondary mb-1">@Localizer["Gamification.Streak"]</h3>
                            <p class="h3 fw-bold mb-0 text-body-emphasis">@Days(streak.Current)</p>
                        </div>
                    </div>
                    <p class="small text-secondary mt-3 mb-1">@Localizer["Gamification.BestStreak", Days(streak.Best)]</p>
                    <p class="small mb-0 @(streak.PracticedToday ? "text-success" : "text-body-emphasis")">
                        @if (streak.PracticedToday)
                        {
                            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>@Localizer["Gamification.PracticedToday"]
                        }
                        else
                        {
                            @Localizer[streak.Current > 0 ? "Gamification.StreakHint" : "Gamification.StreakStart"]
                        }
                    </p>
                </div>
            </div>
            <div class="col">
                <div class="aa-card p-4 h-100 d-flex flex-column" data-tour="progress">
                    <div class="d-flex align-items-center gap-3">
                        <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-award"></i></span>
                        <div>
                            <h3 class="h6 text-uppercase small text-secondary mb-1">@Localizer["Gamification.Title"]</h3>
                            <p class="h3 fw-bold mb-0 text-body-emphasis">@Localizer["Gamification.BadgesCount", profile.EarnedCount, profile.Badges.Count]</p>
                        </div>
                    </div>
                    @if (latestBadges.Count > 0)
                    {
                        <ul class="aa-medal-row mt-3">
                            @foreach (var badge in latestBadges)
                            {
                                <li>
                                    <span class="aa-medal-disc aa-medal-@badge.Group.ToString().ToLowerInvariant() @(badge.IsNew ? "is-new" : null)" title="@badge.Title">
                                        <img src="@Url.BadgeImage(badge.Key)" alt="" />
                                        <span class="visually-hidden">@badge.Title</span>
                                        @if (badge.IsNew)
                                        {
                                            <span class="visually-hidden">(@Localizer["Gamification.New"])</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small text-secondary mt-3 mb-0">@Localizer["Gamification.NoBadgesYet"]</p>
                    }
                    <a class="small fw-semibold mt-auto pt-3" asp-action="Achievements">
                        @Localizer["Gamification.ViewAll"]<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- KPIs -->
<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col">
        <div class="aa-card aa-card-accent p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-music-note-list"></i></span>
                <div>
                    <h6 class="text-uppercase small text-secondary mb-1">@Localizer["Dashboard.TotalAnswers"]</h6>
                    <h3 class="fw-bold mb-0 text-body-emphasis">@ViewBag.TotalAnswers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="aa-card aa-card-accent p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-trophy"></i></span>
                <div>
                    <h6 class="text-uppercase small text-secondary mb-1">@Localizer["Dashboard.BestScore"]</h6>
                    <h3 class="fw-bold mb-0 text-body-emphasis">@ViewBag.BestScore</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="aa-card aa-card-accent p-4 h-100">
            <div class="d-flex align-items-center gap-3">
                <span class="aa-icon-pill" aria-hidden="true"><i class="bi bi-stopwatch"></i></span>
                <div>
                    <h6 class="text-uppercase small text-secondary mb-1">@Localizer["Dashboard.TotalTime"]</h6>
                    <h3 class="fw-bold mb-0 text-body-emphasis">@ViewBag.TotalTime <small class="fs-6 text-secondary">min</small></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row row-cols-1 row-cols-lg-2 g-4">
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-graph-up text-primary" aria-hidden="true"></i>@Localizer["Dashboard.LearningTimeline"]
            </h5>
            <canvas id="learningTimelineChart" height="120"></canvas>
        </div>
    </div>
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-bar-chart text-primary" aria-hidden="true"></i>@Localizer["Dashboard.ByDifficulty"]
            </h5>
            <canvas id="difficultyChart" height="120"></canvas>
        </div>
    </div>
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-radar text-primary" aria-hidden="true"></i>@Localizer["Dashboard.TechnicalSkills"]
            </h5>
            <canvas id="radarTechnicalChart" height="180"></canvas>
        </div>
    </div>
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-pie-chart text-primary" aria-hidden="true"></i>@Localizer["Dashboard.PedagogicalCategories"]
            </h5>
            <canvas id="radarCategoryChart" height="180"></canvas>
        </div>
    </div>
</div>

<!-- Recent sessions -->
<div class="aa-card-flat p-4 mt-4">
    <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
        <i class="bi bi-clock-history text-primary" aria-hidden="true"></i>@Localizer["Dashboard.RecentSessions"]
    </h5>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>@Localizer["Dashboard.Exercise"]</th>
                    <th>@Localizer["Dashboard.Date"]</th>
                    <th>@Localizer["Dashboard.Correct"]</th>
                    <th>@Localizer["Dashboard.Errors"]</th>
                    <th>@Localizer["Dashboard.TimeSpent"]</th>
                    <th>@Localizer["Dashboard.Score"]</th>
                </tr>
            </thead>
            <tbody id="scoreHistoryTable"></tbody>
        </table>
    </div>
</div>

<!-- Difficulties + Recommendations -->
<div class="row row-cols-1 row-cols-lg-2 g-4 mt-2">
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-exclamation-triangle text-warning" aria-hidden="true"></i>@Localizer["Dashboard.MostMissedItems"]
            </h5>
            <p class="small text-secondary mb-2">@Localizer["Dashboard.MostMissedHint", AcademiaAuditiva.Services.Dashboard.DashboardStats.RecentAnswers]</p>
            <ul class="list-group list-group-flush" id="mostMissedList"></ul>
        </div>
    </div>
    <div class="col">
        <div class="aa-card-flat p-4 h-100">
            <h5 class="mb-3 d-flex align-items-center gap-2 text-body-emphasis">
                <i class="bi bi-lightbulb text-primary" aria-hidden="true"></i>@Localizer["Dashboard.Recommendations"]
            </h5>
            <div id="recommendationsList" class="list-group list-group-flush"></div>
        </div>
    </div>
</div>

<div id="localizer"
     data-culture="@System.Globalization.CultureInfo.CurrentCulture.Name"
     data-answers="@Localizer["Dashboard.TotalAnswers"]"
     data-chart-daily-accuracy="@Localizer["Dashboard.ChartDailyAccuracy"]"
     data-chart-accuracy-by-skill="@Localizer["Dashboard.ChartAccuracyBySkill"]"
     data-chart-accuracy-by-category="@Localizer["Dashboard.ChartAccuracyByCategory"]"
     data-chart-accuracy-by-difficulty="@Localizer["Dashboard.ChartAccuracyByDifficulty"]"
     data-diff-Beginner="@Localizer["Exercise.Beginner"]"
     data-diff-Intermediate="@Localizer["Exercise.Intermediate"]"
     data-diff-Advanced="@Localizer["Exercise.Advanced"]"></div>

@{
    var skillNames = new[] { "NoteRecognition", "ChordRecognition", "IntervalRecognition", "FunctionRecognition", "MelodyReproduction", "RhythmPatterns", "HarmonicField", "ScaleRecognition" };
    var categoryNames = new[] { "Harmony", "Melody", "Rhythm", "EarTraining", "Scales", "Games", "Misc" };
    var i18nMap = new {
        skills = skillNames.ToDictionary(n => n, n => S["ExerciseType." + n].Value),
        categories = categoryNames.ToDictionary(n => n, n => S["ExerciseCategory." + n].Value),
        exercises = ViewBag.ExerciseNames as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>()
    };
    var i18nJson = System.Text.Json.JsonSerializer.Serialize(i18nMap, new System.Text.Json.JsonSerializerOptions {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
}
<script id="aa-i18n-map" type="application/json">@Html.Raw(i18nJson)</script>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"
            integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        let aaI18n = { skills: {}, categories: {}, exercises: {} };
        try {
            const raw = document.getElementById('aa-i18n-map')?.textContent;
            if (raw) aaI18n = JSON.parse(raw);
        } catch (e) { console.warn('aa-i18n-map parse failed', e); }
        const tSkill = k => aaI18n.skills[k] || k;
        const tCat = k => aaI18n.categories[k] || k;
        const tExercise = k => aaI18n.exercises[k] || k;

        // Charts take their colours from the design-system CSS variables and are
        // rebuilt when the theme changes, so they always match light/dark mode.
        const aaCharts = [];

        function aaChartTheme() {
            const css = getComputedStyle(document.documentElement);
            const read = name => css.getPropertyValue(name).trim();
            return {
                accent: read('--aa-accent'),
                accentRgb: read('--aa-accent-rgb'),
                muted: read('--aa-muted'),
                line: read('--aa-line'),
                font: read('--aa-font-ui')
            };
        }

        function aaThemedConfig(base) {
            const t = aaChartTheme();
            Chart.defaults.color = t.muted;
            Chart.defaults.borderColor = t.line;
            Chart.defaults.font.family = t.font;

            const type = base.type;
            const fillAlpha = type === 'bar' ? 0.75 : (type === 'radar' ? 0.18 : 0.12);
            const datasets = base.data.datasets.map(d => Object.assign({}, d, {
                borderColor: t.accent,
                backgroundColor: `rgba(${t.accentRgb}, ${fillAlpha})`,
                pointBackgroundColor: t.accent,
                pointBorderColor: t.accent,
                borderWidth: type === 'line' ? 2 : 1.5
            }, type === 'bar' ? { borderRadius: 6 } : {}));

            const baseScales = Object.assign(type === 'radar' ? {} : { x: {} }, base.options?.scales || {});
            const scales = {};
            for (const [key, scale] of Object.entries(baseScales)) {
                scales[key] = Object.assign({}, scale, {
                    grid: { color: t.line },
                    border: { color: t.line },
                    ticks: { color: t.muted, backdropColor: 'transparent' }
                });
                if (type === 'radar') {
                    scales[key].angleLines = { color: t.line };
                    scales[key].pointLabels = { color: t.muted, font: { family: t.font, size: 12 } };
                }
            }

            return {
                type,
                data: { labels: base.data.labels, datasets },
                options: Object.assign({}, base.options, {
                    scales,
                    plugins: Object.assign({}, base.options?.plugins, {
                        legend: { labels: { color: t.muted, font: { family: t.font } } }
                    })
                })
            };
        }

        function aaChart(canvas, base) {
            if (!canvas) return;
            aaCharts.push({ canvas, base, chart: new Chart(canvas, aaThemedConfig(base)) });
        }

        new MutationObserver(() => {
            aaCharts.forEach(entry => {
                entry.chart.destroy();
                entry.chart = new Chart(entry.canvas, aaThemedConfig(entry.base));
            });
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });

        document.addEventListener("DOMContentLoaded", () => {
            const loc = document.getElementById("localizer")?.dataset;
            const culture = loc.culture || undefined;

            // Days arrive as yyyy-MM-dd in the student's time zone: build them as local
            // dates, since parsing the string would read it as midnight UTC.
            const dayFormat = new Intl.DateTimeFormat(culture, { day: 'numeric', month: 'short' });
            const localDay = date => {
                const [year, month, day] = date.split('-').map(Number);
                return new Date(year, month - 1, day);
            };

            fetch("/Dashboard/GetUserTimeline")
                .then(res => res.json())
                .then(data => {
                    const ctx = document.getElementById("learningTimelineChart");

                    aaChart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.map(d => dayFormat.format(localDay(d.date))),
                            datasets: [{
                                label: loc.chartDailyAccuracy,
                                data: data.map(d => d.accuracy),
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            locale: culture,
                            scales: {
                                y: { min: 0, max: 100 }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        afterLabel: item => `${loc.answers}: ${data[item.dataIndex].answers}`
                                    }
                                }
                            }
                        }
                    });
                });

            // Radar técnico
            fetch("/Dashboard/GetUserProgress")
                .then(res => res.json())
                .then(data => {
                    const radarCtx = document.getElementById("radarTechnicalChart");
                    const labels = Object.keys(data.radar).map(tSkill);
                    const values = Object.values(data.radar);

                    aaChart(radarCtx, {
                        type: 'radar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: loc.chartAccuracyBySkill,
                                data: values
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                r: { min: 0, max: 100 }
                            }
                        }
                    });

                    const radarCat = document.getElementById("radarCategoryChart");
                    const catLabels = Object.keys(data.byCategory).map(tCat);
                    const catValues = Object.values(data.byCategory);

                    aaChart(radarCat, {
                        type: 'radar',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                label: loc.chartAccuracyByCategory,
                                data: catValues
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                r: { min: 0, max: 100 }
                            }
                        }
                    });
                });

            // Sessões recentes
            const formatDuration = seconds => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
            const startFormat = new Intl.DateTimeFormat(culture, { dateStyle: 'short', timeStyle: 'short' });
            const cell = (text, className) => {
                const td = document.createElement("td");
                if (className) {
                    const span = document.createElement("span");
                    span.className = className;
                    span.textContent = text;
                    td.appendChild(span);
                } else {
                    td.textContent = text;
                }
                return td;
            };
            fetch("/Dashboard/GetScoreHistory")
                .then(res => res.json())
                .then(data => {
                    const tbody = document.getElementById("scoreHistoryTable");
                    data.forEach(session => {
                        const tr = document.createElement("tr");
                        tr.append(
                            cell(tExercise(session.exercise)),
                            cell(startFormat.format(new Date(session.start))),
                            cell(session.correct, "text-success fw-semibold"),
                            cell(session.errors, "text-danger fw-semibold"),
                            cell(formatDuration(session.timeSpentSeconds)),
                            cell(session.score, "aa-badge-soft"));
                        tbody.appendChild(tr);
                    });
                });

            // Dificuldade
            fetch("/Dashboard/GetPerformanceByDifficulty")
                .then(res => res.json())
                .then(data => {
                    const ctx = document.getElementById("difficultyChart");
                    const values = data.map(d => d.accuracy);

                    const labelMap = {
                        beginner: loc.diffBeginner,
                        intermediate: loc.diffIntermediate,
                        advanced: loc.diffAdvanced
                    };
                    const labels = data.map(d => labelMap[d.difficulty.toLowerCase()] ?? d.difficulty);

                    aaChart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: loc.chartAccuracyByDifficulty,
                                data: values
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: { beginAtZero: true, max: 100 }
                            }
                        }
                    });
                });

            // Maiores dificuldades
            const shareFormat = new Intl.NumberFormat(culture, { style: 'percent', maximumFractionDigits: 0 });
            fetch("/Dashboard/GetMostMissedItems")
                .then(res => res.json())
                .then(data => {
                    const list = document.getElementById("mostMissedList");
                    data.forEach(item => {
                        const li = document.createElement("li");
                        li.classList.add("list-group-item", "d-flex", "justify-content-between", "align-items-center", "border-0", "px-0");
                        const name = document.createElement("span");
                        name.textContent = tExercise(item.exercise);
                        const share = document.createElement("span");
                        share.className = "badge bg-danger-subtle text-danger-emphasis";
                        share.textContent = shareFormat.format(item.errors / item.answers);
                        share.title = `${item.errors}/${item.answers}`;
                        li.append(name, share);
                        list.appendChild(li);
                    });
                });

            // Recomendações
            fetch("/Dashboard/GetRecommendations")
                .then(res => res.json())
                .then(data => {
                    const list = document.getElementById("recommendationsList");
                    data.forEach(msg => {
                        const div = document.createElement("div");
                        div.classList.add("list-group-item", "border-0", "px-0", "d-flex", "align-items-start", "gap-2");
                        const icon = document.createElement("i");
                        icon.className = "bi bi-arrow-right-circle text-primary mt-1";
                        icon.setAttribute("aria-hidden", "true");
                        const text = document.createElement("span");
                        text.textContent = msg;
                        div.append(icon, text);
                        list.appendChild(div);
                    });
                });
        });
    </script>
}
