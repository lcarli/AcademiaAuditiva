@model AcademiaAuditiva.ViewModels.ExerciseViewModel
@{
    ViewData["Title"] = Localizer[Model.Title].Value;
    ViewData["FiltersPartial"] = "_ExerciseFilters";
}

@await Html.PartialAsync("_ExerciseHeader", Model)
<input type="hidden" id="exerciseId" value="@Model.ExerciseId" />

<div class="row g-4">
    <div class="col-lg-8 order-lg-2">
        <section class="aa-panel" aria-labelledby="aa-question">
            <h2 id="aa-question" class="aa-question">@Localizer["Exercise.LevelMatch.Question"]</h2>

            <div class="d-flex justify-content-center mb-4">
                <button type="button" id="Play" class="btn btn-primary px-4" data-aa-audio-unlock>
                    <i class="bi bi-shuffle me-1" aria-hidden="true"></i>@Localizer["Exercise.LevelMatch.New"]
                </button>
            </div>

            @await Html.PartialAsync("_ABPlayback")

            <div class="aa-answer-grid mt-4" role="group" aria-label="@Localizer["Exercise.LevelMatch.Question"]">
                <button type="button" class="aa-answer guessAnswer" value="A">@Localizer["Exercise.LevelMatch.Answer.A"]</button>
                <button type="button" class="aa-answer guessAnswer" value="B">@Localizer["Exercise.LevelMatch.Answer.B"]</button>
            </div>

            <div class="mt-4" data-aa-lm-difference hidden>
                <h3 class="h6 text-center mb-3">@Localizer["Exercise.LevelMatch.DifferenceQuestion"]</h3>
                <div class="aa-answer-grid" role="group" aria-label="@Localizer["Exercise.LevelMatch.DifferenceQuestion"]">
                    <button type="button" class="aa-answer differenceAnswer" value="0.5" data-levels="advanced">0.5 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="1" data-levels="advanced">1 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="1.5" data-levels="advanced">1.5 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="2" data-levels="intermediate advanced">2 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="3" data-levels="intermediate">3 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="4" data-levels="intermediate">4 dB</button>
                    <button type="button" class="aa-answer differenceAnswer" value="6" data-levels="intermediate">6 dB</button>
                </div>
            </div>

            <div class="aa-validate">
                <button type="button" id="validateGuess" class="btn btn-primary px-4">@Localizer["Exercise.ValidationButton"]</button>
            </div>
        </section>
    </div>
    <div class="col-lg-4 order-lg-1">
        @await Html.PartialAsync("_ExerciseInstructions", Model)
    </div>
</div>

@await Html.PartialAsync("_ExerciseFiltersModal", Model)

<div id="localizer"
     data-incomplete-title="@Localizer["Exercise.IncompleteTitle"]"
     data-incomplete-text="@Localizer["Exercise.LevelMatch.Incomplete"]"
     data-validation-error-title="@Localizer["Exercise.ValidationErrorTitle"]"
     data-validation-error-text="@Localizer["Exercise.ValidationErrorText"]"
     data-correct-message="@Localizer["Exercise.CorrectMessage"]"
     data-wrong-message="@Localizer["Exercise.WrongMessage"]"
     data-feedback-a="@Localizer["Exercise.LevelMatch.Feedback.A"].Value"
     data-feedback-b="@Localizer["Exercise.LevelMatch.Feedback.B"].Value">
</div>

@section Scripts {
    <script src="~/js/Exercises/LevelMatch.js" asp-append-version="true"></script>
}
