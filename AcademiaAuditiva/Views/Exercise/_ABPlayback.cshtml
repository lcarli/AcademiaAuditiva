@inject Microsoft.Extensions.Localization.IStringLocalizer<AcademiaAuditiva.Resources.SharedResources> S

<div class="aa-ab-playback"
     data-aa-ab
     data-ready="@S["Exercise.AB.Ready"]"
     data-loading="@S["Exercise.AB.Loading"]"
     data-playing="@S["Exercise.AB.Playing"]"
     data-error="@S["Exercise.AB.Error"]">
    <div class="aa-ab-controls" role="group" aria-label="@S["Exercise.AB.Label"]">
        @foreach (var key in new[] { "A", "B" })
        {
            <button type="button"
                    class="aa-ab-clip"
                    data-aa-ab-play="@key"
                    aria-label="@S["Exercise.AB.Play", key]"
                    aria-keyshortcuts="@key"
                    aria-pressed="false"
                    disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M7 5l12 7-12 7z" fill="currentColor" />
                </svg>
                <span>@key</span>
            </button>
        }
        <button type="button"
                class="aa-audio-btn"
                data-aa-ab-replay
                title="@S["Exercise.AB.Replay"]"
                aria-label="@S["Exercise.AB.Replay"]"
                aria-keyshortcuts="Space"
                disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12a8 8 0 1 0 2.4-5.7" />
                <path d="M4 4v4h4" />
            </svg>
        </button>
    </div>
    <p class="aa-ab-status small text-secondary mb-0"
       data-aa-ab-status
       role="status"
       aria-live="polite">@S["Exercise.AB.Shortcuts"]</p>
</div>
