@using AcademiaAuditiva.Services.Audio
@model AcademiaAuditiva.ViewModels.ExerciseFiltersViewModel
@{
    // Exercises that play chords leave out the instruments that don't play them.
    var instruments = Instrument.Offered(Model.PlaysChords);
    var activeInstrument = Instrument.FromName(Context.Request.Cookies["instrument"], Model.PlaysChords);
}

<form>
    <div class="mb-4">
        <div class="form-label" id="instrumentLabel">@Localizer["Instrument"]</div>
        <div class="aa-pill-tab" role="group" id="instrumentButtons" aria-labelledby="instrumentLabel">
            @foreach (var instrument in instruments)
            {
                <button type="button"
                        data-instrument="@instrument.Name"
                        data-lowest-octave="@instrument.LowestOctave"
                        data-highest-octave="@instrument.HighestOctave"
                        aria-pressed="@(instrument == activeInstrument ? "true" : "false")">@Localizer[instrument.LabelKey]</button>
            }
        </div>
    </div>

    <div class="mb-3">
        <div class="form-label" id="rangeLabel">@Localizer["Range"]</div>
        <div class="d-flex align-items-center gap-3">
            <span id="rangeStartLabel" class="fw-semibold">C4</span>
            <input type="range" class="form-range" id="rangeStart" min="@activeInstrument.LowestOctave" max="@activeInstrument.HighestOctave" value="4" step="1" aria-labelledby="rangeLabel">
            <input type="range" class="form-range" id="rangeEnd" min="@activeInstrument.LowestOctave" max="@activeInstrument.HighestOctave" value="4" step="1" aria-labelledby="rangeLabel">
            <span id="rangeEndLabel" class="fw-semibold">C4</span>
        </div>
    </div>

    @if (Model.Groups.Count > 0)
    {
        var presets = AcademiaAuditiva.Services.ExerciseFilterPresets.FromQuery(Context.Request.Query, Model.Groups);
        <hr class="my-4" />
        @* The exercise scripts read these selects by id/name, so both stay equal to the group name. *@
        @foreach (var group in Model.Groups)
        {
            presets.TryGetValue(group.Name, out var preset);
            <div class="mb-3">
                <label for="@group.Name" class="form-label">@Localizer[group.Label]</label>
                <select id="@group.Name" name="@group.Name" class="form-select">
                    @foreach (var opt in group.Options)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == preset)">@Localizer[opt.Text]</option>
                    }
                </select>
            </div>
        }
    }
</form>
