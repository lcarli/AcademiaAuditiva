@using AcademiaAuditiva.Services
@using AcademiaAuditiva.Services.Audio
@model AcademiaAuditiva.ViewModels.ExerciseFiltersViewModel
@inject AcademiaAuditiva.Services.Routines.RoutinePage RoutinePage
@inject AcademiaAuditiva.Services.Games.GamePage GamePage
@{
    // Exercises about chords leave out the instruments that don't play them. When the exercise
    // plays chords, the guitar plays them where on the neck the student picks: the position
    // then replaces the note range.
    var instruments = Instrument.Offered(Model.IsChordExercise);
    var activeInstrument = Instrument.FromName(Context.Request.Cookies["instrument"], Model.IsChordExercise);
    var onTheNeck = Model.PlaysChords && activeInstrument.Chords == ChordStyle.Strummed;
    var activePosition = GuitarVoicing.PositionFromName(Context.Request.Cookies["guitarPosition"]);
    var startOctave = MusicTheoryService.DefaultRangeOctave;
}

<form>
    <div class="mb-4">
        <div class="form-label" id="instrumentLabel">@Localizer["Instrument"]</div>
        <div class="aa-pill-tab" role="group" id="instrumentButtons" aria-labelledby="instrumentLabel">
            @foreach (var instrument in instruments)
            {
                <button type="button"
                        data-instrument="@instrument.Name"
                        data-lowest-octave="@instrument.LowestOctave"
                        data-highest-octave="@instrument.HighestOctave"
                        data-lowest-note="@instrument.LowestNote"
                        data-strummed="@(instrument.Chords == ChordStyle.Strummed ? "true" : "false")"
                        aria-pressed="@(instrument == activeInstrument ? "true" : "false")">@Localizer[instrument.LabelKey]</button>
            }
        </div>
    </div>

    @if (Model.PlaysChords)
    {
        <div class="mb-3" id="positionFilter" hidden="@(!onTheNeck)">
            <div class="form-label" id="positionLabel">@Localizer["GuitarPosition"]</div>
            <div class="aa-pill-tab" role="group" id="positionButtons" aria-labelledby="positionLabel">
                @foreach (var position in Enum.GetValues<GuitarPosition>())
                {
                    <button type="button"
                            data-guitar-position="@position"
                            aria-pressed="@(position == activePosition ? "true" : "false")">@Localizer["GuitarPosition." + position]</button>
                }
            </div>
        </div>
    }

    @* Only the exercises whose notes come from the range offer it; the others set their octaves. *@
    @if (Model.UsesNoteRange)
    {
        <div class="mb-3" id="rangeFilter" hidden="@onTheNeck">
            <div class="form-label" id="rangeLabel">@Localizer["Range"]</div>
            <div class="d-flex align-items-center gap-3">
                <span id="rangeStartLabel" class="fw-semibold">@activeInstrument.OctaveLabel(startOctave)</span>
                <input type="range" class="form-range" id="rangeStart" min="@activeInstrument.LowestOctave" max="@activeInstrument.HighestOctave" value="@startOctave" step="1" aria-labelledby="rangeLabel">
                <input type="range" class="form-range" id="rangeEnd" min="@activeInstrument.LowestOctave" max="@activeInstrument.HighestOctave" value="@startOctave" step="1" aria-labelledby="rangeLabel">
                <span id="rangeEndLabel" class="fw-semibold">@activeInstrument.OctaveLabel(startOctave)</span>
            </div>
        </div>
    }

    @if (Model.Groups.Count > 0)
    {
        // A routine question plays with the filters its teacher set (RequestPlay enforces them),
        // and a placement test with its step's; the student picks the others.
        var routine = await RoutinePage.ResolveAsync(Context, Model.ExerciseId);
        var game = routine is null ? await GamePage.ResolveAsync(Context, Model.ExerciseId) : null;
        var locked = routine?.Round?.Item.Filters ?? game?.LockedFilters;
        var lockedNote = routine is null ? "Game.FilterLocked" : "Routine.FilterLocked";
        IReadOnlyDictionary<string, string> presets = locked
            ?? AcademiaAuditiva.Services.ExerciseFilterPresets.FromQuery(Context.Request.Query, Model.Groups);
        <hr class="my-4" />
        @* The exercise scripts read these selects by id/name, so both stay equal to the group name. *@
        @foreach (var group in Model.Groups)
        {
            presets.TryGetValue(group.Name, out var preset);
            var isLocked = locked?.ContainsKey(group.Name) == true;
            <div class="mb-3">
                <label for="@group.Name" class="form-label">@Localizer[group.Label]</label>
                <select id="@group.Name" name="@group.Name" class="form-select" disabled="@isLocked"
                        aria-describedby="@(isLocked ? group.Name + "Locked" : null)">
                    @foreach (var opt in group.Options)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == preset)">@Localizer[opt.Text]</option>
                    }
                </select>
                @if (isLocked)
                {
                    <div class="form-text" id="@(group.Name)Locked">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        @Localizer[lockedNote]
                    </div>
                }
            </div>
        }
    }
</form>
