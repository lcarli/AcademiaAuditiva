@model AcademiaAuditiva.ViewModels.ExerciseViewModel
@{
    // ?practice=free opens the exercise in free practice; wwwroot/js/core/practice.js keeps the URL in step with the switch.
    var freePractice = string.Equals(Context.Request.Query["practice"].ToString(), "free", StringComparison.OrdinalIgnoreCase);
}

<div class="aa-exercise-head@(freePractice ? " is-free" : "")">
    <h1 class="aa-exercise-title">@Localizer[Model.Title]</h1>

    <div class="aa-chips" role="group" aria-label="@Localizer["Score"]">
        @* wwwroot/js/core/practice.js increments these counters through textContent, so they hold only the number. *@
        <span class="aa-chip aa-chip-ok" data-tour="score">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            <span class="visually-hidden">@Localizer["Exercise.CorrectAnswers"]</span>
            <strong id="correctCount">@Model.Score</strong>
        </span>
        <span class="aa-chip aa-chip-err" data-tour="score">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
            <span class="visually-hidden">@Localizer["Exercise.ErrorAnswers"]</span>
            <strong id="errorCount">@Model.Attempts</strong>
        </span>
        <button type="button" class="aa-chip aa-chip-btn" data-bs-toggle="modal" data-bs-target="#filtersModal" data-tour="score">
            <i class="bi bi-sliders" aria-hidden="true"></i>
            @Localizer["Filters"]
        </button>
        <label class="aa-chip aa-chip-switch form-switch" data-tour="free-practice">
            <input class="form-check-input" type="checkbox" role="switch" id="aaFreePractice"
                   checked="@freePractice" autocomplete="off" aria-controls="aaFreeNote" />
            @Localizer["Exercise.Free.Toggle"]
        </label>
        @* tutorial.js shows the button once it can run the tour. *@
        <button type="button" class="aa-chip aa-chip-btn" data-aa-tour-start hidden>
            <i class="bi bi-question-circle" aria-hidden="true"></i>
            @Localizer["Tutorial.Replay"]
        </button>
    </div>
</div>

@await Component.InvokeAsync("Tutorial", new { key = AcademiaAuditiva.Services.Tutorials.TutorialCatalog.Exercise })

<div class="aa-preset aa-free" id="aaFreeNote" role="note" hidden="@(!freePractice)"
     data-reveal-title="@Localizer["Exercise.Free.RevealTitle"].Value"
     data-result-note="@Localizer["Exercise.Free.ResultNote"].Value">
    <i class="bi bi-headphones" aria-hidden="true"></i>
    <div class="aa-preset-body">
        <strong>@Localizer["Exercise.Free.Title"]</strong>
        <span>@Localizer["Exercise.Free.Text"]</span>
    </div>
    <div class="aa-chips" role="group" aria-label="@Localizer["Exercise.Free.Tally"]">
        <span class="aa-chip aa-chip-ok">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            <span class="visually-hidden">@Localizer["Exercise.CorrectAnswers"]</span>
            <strong id="aaFreeCorrect">0</strong>
        </span>
        <span class="aa-chip aa-chip-err">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
            <span class="visually-hidden">@Localizer["Exercise.ErrorAnswers"]</span>
            <strong id="aaFreeWrong">0</strong>
        </span>
    </div>
</div>

@* practice.js puts this button next to #validateGuess; it shows while a free round is on screen. *@
<template id="aaRevealTemplate">
    <button type="button" class="btn btn-outline-secondary px-4" data-aa-reveal hidden>
        <i class="bi bi-eye" aria-hidden="true"></i>
        @Localizer["Exercise.Free.Reveal"]
    </button>
</template>

@{
    // Routine links (My training) and learning path steps open the exercise with its filters in the query string.
    var appliedPresets = AcademiaAuditiva.Services.ExerciseFilterPresets.Describe(
        Model.Filters.Groups,
        AcademiaAuditiva.Services.ExerciseFilterPresets.FromQuery(Context.Request.Query, Model.Filters.Groups));
}
@if (appliedPresets.Count > 0)
{
    <div class="aa-preset" role="note">
        <i class="bi bi-bookmark-check" aria-hidden="true"></i>
        <div class="aa-preset-body">
            <strong>@Localizer["Exercise.Preset.Title"]</strong>
            <ul class="aa-preset-list">
                @foreach (var applied in appliedPresets)
                {
                    <li class="aa-badge-soft">@Localizer["Common.LabelValue", Localizer[applied.Group.Label], Localizer[applied.Option.Text]]</li>
                }
            </ul>
        </div>
        <button type="button" class="btn btn-link btn-sm aa-preset-change" data-bs-toggle="modal" data-bs-target="#filtersModal">
            @Localizer["Exercise.Preset.Change"]
        </button>
    </div>
}
