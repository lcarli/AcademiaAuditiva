@model Dictionary<string, Dictionary<string, string>>
@{
    // A group holding the 12 pitch classes in order is drawn as a one-octave keyboard
    // (with a toggle back to plain buttons). The exercise scripts read button.value and
    // toggle the .selected class, so every label stays plain text.
    string[] chromatic = { "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B" };
    int[] keyColumns = { 1, 2, 3, 4, 5, 7, 8, 9, 10, 11, 12, 13 };
}

@functions {
    private static string? AnswerResourceKey(string label, string value)
    {
        return value switch
        {
            "same" => "Exercise.Answer.Same",
            "diff" => "Exercise.Answer.Different",
            "higher" => "Exercise.HigherAnswer",
            "lower" => "Exercise.LowerAnswer",
            "major" => "Exercise.ChordQuality.Major",
            "majorPentatonic" => "Exercise.ScaleTypeMajorPentatonic",
            "major7" => "Exercise.ChordQuality.Major7",
            "minor" => "Exercise.ChordQuality.Minor",
            "minorPentatonic" => "Exercise.ScaleTypeMinorPentatonic",
            "minor7" => "Exercise.ChordQuality.Minor7",
            "diminished" => "Exercise.ChordQuality.Diminished",
            "diminished7" => "Exercise.ChordQuality.Diminished7",
            "augmented" => "Exercise.ChordQuality.Augmented",
            "ionian" => "Exercise.ModeIonian",
            "dorian" => "Exercise.ModeDorian",
            "phrygian" => "Exercise.ModePhrygian",
            "lydian" => "Exercise.ModeLydian",
            "mixolydian" => "Exercise.ModeMixolydian",
            "aeolian" => "Exercise.ModeAeolian",
            "locrian" => "Exercise.ModeLocrian",
            "perfect" => "Exercise.CadencePerfect",
            "plagal" => "Exercise.CadencePlagal",
            "imperfect" => "Exercise.CadenceImperfect",
            "deceptive" => "Exercise.CadenceDeceptive",
            "root" => "Exercise.InversionRoot",
            "first" => "Exercise.InversionFirst",
            "second" => "Exercise.InversionSecond",
            "2m" => "Exercise.Interval.2min",
            "2M" => "Exercise.Interval.2maj",
            "3m" => "Exercise.Interval.3min",
            "3M" => "Exercise.Interval.3maj",
            "4J" => "Exercise.Interval.4J",
            "4A" => "Exercise.Interval.4A",
            "5d" => "Exercise.Interval.5dim",
            "5J" => "Exercise.Interval.5J",
            "6m" => "Exercise.Interval.6min",
            "6M" => "Exercise.Interval.6maj",
            "7m" => "Exercise.Interval.7min",
            "7M" => "Exercise.Interval.7maj",
            "8J" => "Exercise.Interval.8J",
            "C" or "C#" or "D" or "D#" or "E" or "F" or "F#" or "G" or "G#" or "A" or "A#" or "B" => "Exercise.Note." + value.Replace("#", "Sharp"),
            _ => null
        };
    }
}

@if (Model != null && Model.Count > 0)
{
    foreach (var group in Model)
    {
        if (group.Value.Values.SequenceEqual(chromatic))
        {
            var groupId = "aa-answers-" + group.Key;
            var index = 0;

            <div class="aa-answer-toolbar">
                <div class="aa-pill-tab aa-answer-toggle" role="group" aria-label="@Localizer["Exercise.AnswerLayout"]" data-layout-target="@groupId">
                    <button type="button" data-set-layout="piano" aria-pressed="true">@Localizer["Exercise.AnswerLayout.Keyboard"]</button>
                    <button type="button" data-set-layout="buttons" aria-pressed="false">@Localizer["Exercise.AnswerLayout.Buttons"]</button>
                </div>
            </div>
            <div id="@groupId" class="aa-answers-chromatic" data-layout="piano">
                @foreach (var kvp in group.Value)
                {
                    var keyClass = kvp.Value.Contains('#') ? "aa-key-black" : "aa-key-white";
                    var column = keyColumns[index++];
                    var resourceKey = AnswerResourceKey(kvp.Key, kvp.Value);
                    var label = resourceKey is null ? kvp.Key.Replace("#", "♯") : Localizer[resourceKey].Value;
                    <button type="button" class="aa-answer aa-key @keyClass @group.Key" value="@kvp.Value" style="--c:@column">@label</button>
                }
            </div>
        }
        else
        {
            <div class="aa-answer-grid">
                @foreach (var kvp in group.Value)
                {
                    var resourceKey = AnswerResourceKey(kvp.Key, kvp.Value);
                    var label = resourceKey is null ? kvp.Key : Localizer[resourceKey].Value;
                    <button type="button" class="aa-answer @group.Key" value="@kvp.Value">@label</button>
                }
            </div>
        }
    }

    <script>
        (function () {
            // Mirror the .selected class set by the exercise scripts to aria-pressed.
            function sync(button) {
                button.setAttribute("aria-pressed", button.classList.contains("selected") ? "true" : "false");
            }
            var observer = new MutationObserver(function (records) {
                records.forEach(function (record) { sync(record.target); });
            });
            document.querySelectorAll(".aa-answer").forEach(function (button) {
                sync(button);
                observer.observe(button, { attributes: true, attributeFilter: ["class"] });
            });

            // Keyboard or buttons layout, remembered across exercises.
            var storageKey = "aa-answer-layout";
            var saved = null;
            try { saved = localStorage.getItem(storageKey); } catch (e) { }
            document.querySelectorAll(".aa-answer-toggle").forEach(function (toggle) {
                var target = document.getElementById(toggle.getAttribute("data-layout-target"));
                if (!target) return;
                var buttons = toggle.querySelectorAll("[data-set-layout]");
                function apply(layout) {
                    target.setAttribute("data-layout", layout);
                    buttons.forEach(function (b) {
                        b.setAttribute("aria-pressed", b.getAttribute("data-set-layout") === layout ? "true" : "false");
                    });
                }
                if (saved === "piano" || saved === "buttons") apply(saved);
                buttons.forEach(function (b) {
                    b.addEventListener("click", function () {
                        var layout = b.getAttribute("data-set-layout");
                        apply(layout);
                        try { localStorage.setItem(storageKey, layout); } catch (e) { }
                    });
                });
            });
        })();
    </script>
}
else
{
    <p class="text-center text-secondary mt-3 mb-0">@Localizer["Exercise.NoAnswers"]</p>
}
