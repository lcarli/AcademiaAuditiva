@inject Microsoft.Extensions.Localization.IStringLocalizer<AcademiaAuditiva.Resources.SharedResources> S
@using AcademiaAuditiva.Extensions
@using AcademiaAuditiva.Services
@using AcademiaAuditiva.Services.Audio
@using AcademiaAuditiva.ViewModels
@model IEnumerable<AcademiaAuditiva.Models.Exercise>

@{
    ViewBag.Title = Localizer["Exercise.Header"].Value;
    var difficulties = (List<DifficultyLevel>)ViewBag.DifficultyLevels;
    var categories = (List<ExerciseCategory>)ViewBag.ExerciseCategories;
    var catalogFilters = (ExerciseCatalogFiltersViewModel)ViewBag.CatalogFilters;
    var availableLevels = (Dictionary<int, DifficultyLevel[]>)ViewBag.AvailableLevels;
}

@functions {
    string LocCategory(ExerciseCategory category)
    {
        var loc = S[$"ExerciseCategory.{category.Name}"];
        if (!loc.ResourceNotFound)
            return loc.Value;
        return string.IsNullOrWhiteSpace(category.DisplayName) ? category.Name : category.DisplayName;
    }

    Dictionary<string, object?> StartFilters(Exercise exercise, string? level)
    {
        var filters = new Dictionary<string, object?>();
        if (level is not null && TrainingTracks.OfCategory(exercise.ExerciseCategory.Name) == TrainingTracks.Audio)
            filters[TechnicalListeningRoundGenerator.LevelFilterFor(exercise.Name)] = level;
        return filters;
    }
}

<header class="text-center mb-4">
    <span class="aa-eyebrow">@Localizer["Exercise.Header"]</span>
    <h1 class="display-6 mt-2 text-body-emphasis">@Localizer["Exercise.Title"]</h1>
</header>

@{
    var track = (string)ViewBag.Track;
    var tracks = (List<AcademiaAuditiva.Services.TrainingTrack>)ViewBag.Tracks;
    var clearRoute = new Dictionary<string, object?> { ["track"] = track.ToLowerInvariant() };
    foreach (var key in new[] { "culture", "ui-culture" })
    {
        if (Context.Request.Query.TryGetValue(key, out var culture))
            clearRoute[key] = culture.ToString();
    }
}
@if (tracks.Count > 0)
{
    <nav class="d-flex justify-content-center mb-4" aria-label="@Localizer["TrainingTrack.Label"]">
        <div class="aa-pill-tab" id="trackTabs">
            @foreach (var t in tracks)
            {
                var isCurrent = t.Key == track;
                <a class="@(isCurrent ? "active" : null)" href="@Url.Action("Index", "Exercise", new { track = t.Key.ToLowerInvariant() })" aria-current="@(isCurrent ? "page" : null)">
                    @Localizer["TrainingTrack." + t.Key]
                </a>
            }
        </div>
    </nav>
}

@if (catalogFilters.TrackHasExercises)
{
    <form method="get" action="@Url.Action("Index", "Exercise")" class="aa-card p-3 p-md-4 mb-4" id="catalogFilters">
        <input type="hidden" name="track" value="@track.ToLowerInvariant()" />
        @foreach (var key in new[] { "culture", "ui-culture" })
        {
            @if (Context.Request.Query.TryGetValue(key, out var culture))
            {
                <input type="hidden" name="@key" value="@culture" />
            }
        }
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="catalogCategory" class="form-label">@Localizer["Exercise.Filter.Category"]</label>
                <select id="catalogCategory" name="category" class="form-select">
                    <option value="">@Localizer["Exercise.Filter.AllCategories"]</option>
                    @foreach (var category in catalogFilters.Categories)
                    {
                        <option value="@category.Name" selected="@(category.Name == catalogFilters.Category)">@LocCategory(category)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="catalogType" class="form-label">@Localizer["Exercise.Filter.Type"]</label>
                <select id="catalogType" name="type" class="form-select">
                    <option value="">@Localizer["Exercise.Filter.AllTypes"]</option>
                    @foreach (var type in catalogFilters.Types)
                    {
                        <option value="@type.Name" selected="@(type.Name == catalogFilters.Type)">@Localizer["ExerciseType." + type.Name]</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="catalogLevel" class="form-label">@Localizer["Exercise.Filter.Level"]</label>
                <select id="catalogLevel" name="level" class="form-select">
                    <option value="">@Localizer["Exercise.Filter.AllLevels"]</option>
                    @foreach (var level in catalogFilters.Levels)
                    {
                        <option value="@level.Name.ToLowerInvariant()" selected="@(level.Name.ToLowerInvariant() == catalogFilters.Level)">@Localizer["Exercise." + level.Name]</option>
                    }
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button type="submit" class="btn btn-primary">@Localizer["Exercise.Filter.Apply"]</button>
            @if (catalogFilters.IsFiltered)
            {
                <a id="catalogClear" class="btn btn-outline-primary" href="@Url.Action("Index", "Exercise", clearRoute)">@Localizer["Exercise.Filter.Clear"]</a>
            }
            <p id="catalogResults" class="text-secondary mb-0" role="status" data-aa-count="@catalogFilters.ResultsCount">@Localizer[catalogFilters.ResultsCount == 1 ? "Exercise.Filter.ResultCount" : "Exercise.Filter.ResultsCount", catalogFilters.ResultsCount]</p>
        </div>
    </form>
}

@if (!catalogFilters.TrackHasExercises)
{
    <div class="aa-card p-4 p-lg-5 text-center mx-auto" style="max-width: 40rem;" id="trackEmpty">
        <span class="aa-icon-pill mb-3" aria-hidden="true"><i class="bi bi-soundwave"></i></span>
        <h2 class="h5 fw-bold text-body-emphasis">@Localizer["TrainingTrack.Empty.Title", Localizer["TrainingTrack." + track]]</h2>
        <p class="text-secondary mb-3">@Localizer["TrainingTrack.Empty.Text"]</p>
        <a href="@Url.Action("Index", "Exercise")" class="btn btn-outline-primary btn-sm">@Localizer["TrainingTrack.Empty.Back"]</a>
    </div>
}
else if (!Model.Any())
{
    <div id="catalogEmpty" class="aa-card p-4 text-center">
        <p class="mb-0">@Localizer["Exercise.Filter.Empty"]</p>
    </div>
}
else
{
<div class="d-flex justify-content-center mb-4">
    <div class="aa-pill-tab flex-wrap justify-content-center mw-100" role="tablist" id="exerciseTabs">
        <button class="active" id="difficulty-tab" data-bs-toggle="tab" data-bs-target="#byDifficulty" type="button" role="tab" aria-controls="byDifficulty" aria-selected="true">
            <i class="bi bi-bar-chart-steps me-1" aria-hidden="true"></i>@Localizer["Exercise.Tab1.Level"]
        </button>
        <button id="category-tab" data-bs-toggle="tab" data-bs-target="#byCategory" type="button" role="tab" aria-controls="byCategory" aria-selected="false">
            <i class="bi bi-collection me-1" aria-hidden="true"></i>@Localizer["Exercise.Tab3.Category"]
        </button>
        <button id="type-tab" data-bs-toggle="tab" data-bs-target="#byType" type="button" role="tab" aria-controls="byType" aria-selected="false">
            <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>@Localizer["Exercise.Tab2.Type"]
        </button>
    </div>
</div>

<div class="tab-content" id="exerciseTabsContent">
    <div class="tab-pane fade show active" id="byDifficulty" role="tabpanel" aria-labelledby="difficulty-tab" tabindex="0">
        @foreach (var level in difficulties)
        {
            var levelName = "Exercise." + level.Name;
            var levelValue = level.Name.ToLowerInvariant();
            var levelExercises = Model.Where(e => availableLevels[e.ExerciseId].Contains(level)
                && (catalogFilters.Level is null || catalogFilters.Level == levelValue)).ToArray();
            if (levelExercises.Length == 0)
                continue;
            <section class="mb-5" data-aa-difficulty="@levelValue">
                <h4 class="aa-eyebrow mb-3">@Localizer[levelName]</h4>
                <div class="row g-4">
                    @foreach (var exercise in levelExercises)
                    {
                        var filters = StartFilters(exercise, levelValue);
                        @await Html.PartialAsync("_ExerciseCatalogCard", new ExerciseCatalogCardViewModel(exercise, LocCategory(exercise.ExerciseCategory), Filters: filters))
                    }
                </div>
            </section>
        }
    </div>

    <div class="tab-pane fade" id="byCategory" role="tabpanel" aria-labelledby="category-tab" tabindex="0">
        @foreach (var category in categories)
        {
            <section class="mb-5" data-aa-category="@category.Name">
                <h4 class="aa-eyebrow mb-3">@LocCategory(category)</h4>
                <div class="row g-4">
                    @foreach (var exercise in Model.Where(e => e.ExerciseCategoryId == category.Id))
                    {
                        @await Html.PartialAsync("_ExerciseCatalogCard", new ExerciseCatalogCardViewModel(exercise, LocCategory(category),
                            availableLevels[exercise.ExerciseId].Where(l => catalogFilters.Level is null || l.Name.ToLowerInvariant() == catalogFilters.Level).ToArray(),
                            StartFilters(exercise, catalogFilters.Level)))
                    }
                </div>
            </section>
        }
    </div>

    <div class="tab-pane fade" id="byType" role="tabpanel" aria-labelledby="type-tab" tabindex="0">
        @foreach (var type in (List<ExerciseType>)ViewBag.ExerciseTypes)
        {
            var typeName = "ExerciseType." + type.Name;
            <section class="mb-5" data-aa-type="@type.Name">
                <h4 class="aa-eyebrow mb-3">@Localizer[typeName]</h4>
                <div class="row g-4">
                    @foreach (var exercise in Model.Where(e => e.ExerciseTypeId == type.Id))
                    {
                        @await Html.PartialAsync("_ExerciseCatalogCard", new ExerciseCatalogCardViewModel(exercise, LocCategory(exercise.ExerciseCategory),
                            availableLevels[exercise.ExerciseId].Where(l => catalogFilters.Level is null || l.Name.ToLowerInvariant() == catalogFilters.Level).ToArray(),
                            StartFilters(exercise, catalogFilters.Level)))
                    }
                </div>
            </section>
        }
    </div>
</div>
}
