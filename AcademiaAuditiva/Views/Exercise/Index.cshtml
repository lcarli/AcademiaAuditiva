@inject Microsoft.Extensions.Localization.IStringLocalizer<AcademiaAuditiva.Resources.SharedResources> S
@using AcademiaAuditiva.Extensions
@using AcademiaAuditiva.Services
@using AcademiaAuditiva.Services.Audio
@model IEnumerable<AcademiaAuditiva.Models.Exercise>

@{
    ViewBag.Title = Localizer["Exercise.Header"].Value;
    var difficulties = (List<DifficultyLevel>)ViewBag.DifficultyLevels;
    var audioLevels = Model.Where(e => ExerciseCatalog.TrackOf(e.Name) == TrainingTracks.Audio)
        .ToDictionary(e => e.ExerciseId, e => ExerciseFilterPresets.Groups(e.FiltersJson)
            .Single(group => group.Name == TechnicalListeningRoundGenerator.LevelFilterFor(e.Name)));
    var availableLevels = Model.ToDictionary(e => e.ExerciseId, e => difficulties.Where(level =>
        audioLevels.TryGetValue(e.ExerciseId, out var group)
            ? group.Options.Any(option => option.Value == level.Name.ToLowerInvariant())
            : e.DifficultyLevelId == level.Id).ToArray());
}

@functions {
    string LocSubtitle(AcademiaAuditiva.Models.Exercise e)
    {
        var loc = S[$"Exercise.{e.Name}.Subtitle"];
        return loc.ResourceNotFound ? e.Description : loc.Value;
    }
}

<header class="text-center mb-4">
    <span class="aa-eyebrow">@Localizer["Exercise.Header"]</span>
    <h1 class="display-6 mt-2 text-body-emphasis">@Localizer["Exercise.Title"]</h1>
</header>

@{
    var track = (string)ViewBag.Track;
    var tracks = (List<AcademiaAuditiva.Services.TrainingTrack>)ViewBag.Tracks;
}
@if (tracks.Count > 0)
{
    <nav class="d-flex justify-content-center mb-4" aria-label="@Localizer["TrainingTrack.Label"]">
        <div class="aa-pill-tab" id="trackTabs">
            @foreach (var t in tracks)
            {
                var isCurrent = t.Key == track;
                <a class="@(isCurrent ? "active" : null)" href="@Url.Action("Index", "Exercise", new { track = t.Key.ToLowerInvariant() })" aria-current="@(isCurrent ? "page" : null)">
                    @Localizer["TrainingTrack." + t.Key]
                </a>
            }
        </div>
    </nav>
}

@if (!Model.Any())
{
    <div class="aa-card p-4 p-lg-5 text-center mx-auto" style="max-width: 40rem;" id="trackEmpty">
        <span class="aa-icon-pill mb-3" aria-hidden="true"><i class="bi bi-soundwave"></i></span>
        <h2 class="h5 fw-bold text-body-emphasis">@Localizer["TrainingTrack.Empty.Title", Localizer["TrainingTrack." + track]]</h2>
        <p class="text-secondary mb-3">@Localizer["TrainingTrack.Empty.Text"]</p>
        <a href="@Url.Action("Index", "Exercise")" class="btn btn-outline-primary btn-sm">@Localizer["TrainingTrack.Empty.Back"]</a>
    </div>
}
else
{
<div class="d-flex justify-content-center mb-4">
    <div class="aa-pill-tab" role="tablist" id="exerciseTabs">
        <button class="active" id="difficulty-tab" data-bs-toggle="tab" data-bs-target="#byDifficulty" type="button" role="tab">
            <i class="bi bi-bar-chart-steps me-1" aria-hidden="true"></i>@Localizer["Exercise.Tab1.Level"]
        </button>
        <button id="type-tab" data-bs-toggle="tab" data-bs-target="#byType" type="button" role="tab">
            <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>@Localizer["Exercise.Tab2.Type"]
        </button>
    </div>
</div>

<div class="tab-content" id="exerciseTabsContent">
    <div class="tab-pane fade show active" id="byDifficulty" role="tabpanel">
        @foreach (var level in difficulties)
        {
            var levelName = "Exercise." + level.Name;
            var levelValue = level.Name.ToLowerInvariant();
            <section class="mb-5" data-aa-difficulty="@levelValue">
                <h4 class="aa-eyebrow mb-3">@Localizer[levelName]</h4>
                <div class="row g-4">
                    @foreach (var exercise in Model.Where(e => availableLevels[e.ExerciseId].Contains(level)))
                    {
                        var filters = new Dictionary<string, object?>();
                        if (audioLevels.TryGetValue(exercise.ExerciseId, out var group))
                        {
                            filters[group.Name] = levelValue;
                        }
                        <div class="col-md-6 col-lg-4">
                            <div class="aa-card aa-card-accent h-100 p-4 d-flex flex-column" data-aa-exercise="@exercise.Name">
                                <span class="aa-icon-pill mb-3" aria-hidden="true"><i class="bi bi-music-note-beamed"></i></span>
                                <h5 class="fw-bold text-body-emphasis">@Localizer[exercise.Name]</h5>
                                <p class="small text-secondary mb-2">
                                    <i class="bi bi-bullseye me-1" aria-hidden="true"></i>@Localizer["ExerciseType." + exercise.ExerciseType.Name]
                                </p>
                                <p class="card-text small text-secondary flex-grow-1">@LocSubtitle(exercise)</p>
                                <a href="@Url.Action(exercise.Name, "Exercise", filters)" class="btn btn-primary btn-sm align-self-start">
                                    <i class="bi bi-play-fill me-1" aria-hidden="true"></i>@Localizer["Exercise.Start"]
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <div class="tab-pane fade" id="byType" role="tabpanel">
        @foreach (var type in (List<ExerciseType>)ViewBag.ExerciseTypes)
        {
            var typeName = "ExerciseType." + type.Name;
            <section class="mb-5">
                <h4 class="aa-eyebrow mb-3">@Localizer[typeName]</h4>
                <div class="row g-4">
                    @foreach (var exercise in Model.Where(e => e.ExerciseType == type))
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="aa-card aa-card-accent h-100 p-4 d-flex flex-column" data-aa-exercise="@exercise.Name">
                                <span class="aa-icon-pill mb-3" aria-hidden="true"><i class="bi bi-puzzle"></i></span>
                                <h5 class="fw-bold text-body-emphasis">@Localizer[exercise.Name]</h5>
                                <p class="small text-secondary mb-2">
                                    <i class="bi bi-bar-chart-steps me-1" aria-hidden="true"></i>@string.Join(" / ", availableLevels[exercise.ExerciseId].Select(level => Localizer["Exercise." + level.Name].Value))
                                </p>
                                <p class="card-text small text-secondary flex-grow-1">@LocSubtitle(exercise)</p>
                                <a href="@Url.Action(exercise.Name, "Exercise")" class="btn btn-primary btn-sm align-self-start">
                                    <i class="bi bi-play-fill me-1" aria-hidden="true"></i>@Localizer["Exercise.Start"]
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</div>
}
