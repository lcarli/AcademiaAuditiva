@model AcademiaAuditiva.ViewModels.ExerciseViewModel
@{
    ViewData["Title"] = Localizer[Model.Title].Value;
    ViewData["FiltersPartial"] = "_ExerciseFilters";
    // Left to right, each with the levels that offer it.
    var positions = new (string Code, string Levels)[]
    {
        ("L", "beginner"),
        ("L75", "intermediate advanced"),
        ("L50", "advanced"),
        ("L25", "intermediate advanced"),
        ("C", "beginner intermediate advanced"),
        ("R25", "intermediate advanced"),
        ("R50", "advanced"),
        ("R75", "intermediate advanced"),
        ("R", "beginner"),
    };
}

@await Html.PartialAsync("_ExerciseHeader", Model)
<input type="hidden" id="exerciseId" value="@Model.ExerciseId" />

<div class="row g-4">
    <div class="col-lg-8 order-lg-2">
        <section class="aa-panel" aria-labelledby="aa-question">
            <h2 id="aa-question" class="aa-question">@Localizer["Exercise.StereoPosition.Question"]</h2>

            <div class="d-flex justify-content-center mb-4">
                <button type="button" id="Play" class="btn btn-primary px-4" data-aa-audio-unlock>
                    <i class="bi bi-shuffle me-1" aria-hidden="true"></i>@Localizer["Exercise.StereoPosition.New"]
                </button>
            </div>

            @await Html.PartialAsync("_ABPlayback", new ViewDataDictionary(ViewData) { ["ABSingle"] = true })

            <p class="small text-secondary text-center mt-3 mb-0" role="note" data-aa-device-note>
                <i class="bi bi-headphones me-1" aria-hidden="true"></i>@Localizer["Exercise.StereoPosition.DeviceNote"]
            </p>

            <div class="aa-answer-grid mt-4" role="group" aria-label="@Localizer["Exercise.StereoPosition.Question"]">
                @foreach (var (code, levels) in positions)
                {
                    <button type="button" class="aa-answer guessAnswer" value="@code" data-levels="@levels">@PositionLabel(code)</button>
                }
            </div>

            <div class="aa-validate">
                <button type="button" id="validateGuess" class="btn btn-primary px-4">@Localizer["Exercise.ValidationButton"]</button>
            </div>
        </section>
    </div>
    <div class="col-lg-4 order-lg-1">
        @await Html.PartialAsync("_ExerciseInstructions", Model)
    </div>
</div>

@await Html.PartialAsync("_ExerciseFiltersModal", Model)

<div id="localizer"
     data-incomplete-title="@Localizer["Exercise.IncompleteTitle"]"
     data-incomplete-text="@Localizer["Exercise.StereoPosition.Incomplete"]"
     data-validation-error-title="@Localizer["Exercise.ValidationErrorTitle"]"
     data-validation-error-text="@Localizer["Exercise.ValidationErrorText"]"
     data-correct-message="@Localizer["Exercise.CorrectMessage"]"
     data-wrong-message="@Localizer["Exercise.WrongMessage"]"
     data-feedback="@Localizer["Exercise.StereoPosition.Feedback"].Value">
</div>

@section Scripts {
    <script src="~/js/Exercises/StereoPosition.js" asp-append-version="true"></script>
}

@functions {
    private string PositionLabel(string code) => code switch
    {
        "L" => Localizer["Exercise.StereoPosition.Answer.Left"].Value,
        "R" => Localizer["Exercise.StereoPosition.Answer.Right"].Value,
        "C" => Localizer["Exercise.StereoPosition.Answer.Center"].Value,
        _ when code[0] == 'L' => Localizer["Exercise.StereoPosition.Answer.LeftPercent", code[1..]].Value,
        _ => Localizer["Exercise.StereoPosition.Answer.RightPercent", code[1..]].Value,
    };
}
