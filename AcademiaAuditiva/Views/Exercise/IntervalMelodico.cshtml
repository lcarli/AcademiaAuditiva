@model AcademiaAuditiva.ViewModels.ExerciseViewModel
@{
    ViewData["Title"] = Localizer[Model.Title].Value;
    ViewData["FiltersPartial"] = "_ExerciseFilters";
    string[] degrees = { "I", "II", "III", "IV", "V", "VI", "VII" };
    (string Value, string Key)[] intervals =
    {
        ("2m", "Exercise.Interval.2min"),
        ("2M", "Exercise.Interval.2maj"),
        ("3m", "Exercise.Interval.3min"),
        ("3M", "Exercise.Interval.3maj"),
        ("4J", "Exercise.Interval.4J"),
        ("4A", "Exercise.Interval.4A"),
        ("5J", "Exercise.Interval.5J"),
        ("6m", "Exercise.Interval.6min"),
        ("6M", "Exercise.Interval.6maj"),
        ("7m", "Exercise.Interval.7min"),
        ("7M", "Exercise.Interval.7maj"),
        ("8J", "Exercise.Interval.8J")
    };
}

@await Html.PartialAsync("_ExerciseHeader", Model)
<input type="hidden" id="exerciseId" value="@Model.ExerciseId" />

<div class="row g-4">
    <div class="col-lg-8 order-lg-2">
        <section class="aa-panel" aria-labelledby="aa-question">
            <h2 id="aa-question" class="aa-question">@Localizer["Exercise.IntervalMelodicoText"]</h2>

            <div class="aa-audio-row">
                @await Html.PartialAsync("_ExerciseAudioButtons", Model.AudioButtons)
                <div id="waveform" class="aa-wave" aria-hidden="true"></div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label" for="firstDegreeSelect">@Localizer["Exercise.IntervalMelodico.FirstDegree"]</label>
                    <select class="form-select" id="firstDegreeSelect">
                        <option value="">@Localizer["Exercise.SelectOption"]</option>
                        @foreach (var degree in degrees)
                        {
                            <option value="@degree">@degree</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="lastDegreeSelect">@Localizer["Exercise.IntervalMelodico.LastDegree"]</label>
                    <select class="form-select" id="lastDegreeSelect">
                        <option value="">@Localizer["Exercise.SelectOption"]</option>
                        @foreach (var degree in degrees)
                        {
                            <option value="@degree">@degree</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="startIntervalSelect">@Localizer["Exercise.IntervalMelodico.StartInterval"]</label>
                    <select class="form-select" id="startIntervalSelect">
                        <option value="">@Localizer["Exercise.SelectOption"]</option>
                        <option value="Unísono">@Localizer["Exercise.Interval.Unison"]</option>
                        @foreach (var interval in intervals)
                        {
                            <option value="@interval.Value">@Localizer[interval.Key]</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="endIntervalSelect">@Localizer["Exercise.IntervalMelodico.EndInterval"]</label>
                    <select class="form-select" id="endIntervalSelect">
                        <option value="">@Localizer["Exercise.SelectOption"]</option>
                        <option value="Unísono">@Localizer["Exercise.Interval.Unison"]</option>
                        @foreach (var interval in intervals)
                        {
                            <option value="@interval.Value">@Localizer[interval.Key]</option>
                        }
                    </select>
                </div>
            </div>

            <div class="aa-validate">
                <button type="button" id="validateGuess" class="btn btn-primary px-4">@Localizer["Exercise.ValidationButton"]</button>
            </div>
        </section>
    </div>
    <div class="col-lg-4 order-lg-1">
        @await Html.PartialAsync("_ExerciseInstructions", Model)
    </div>
</div>

@await Html.PartialAsync("_ExerciseFiltersModal", Model)

<div id="localizer"
     data-incomplete-title="@Localizer["Exercise.IncompleteTitle"]"
     data-incomplete-text="@Localizer["Exercise.IntervalMelodico.IncompleteText"]"

     data-no-audio-title="@Localizer["Exercise.NoAudioTitle"]"
     data-no-audio-text="@Localizer["Exercise.NoAudioText"]"
     data-validation-error-title="@Localizer["Exercise.ValidationErrorTitle"]"
     data-validation-error-text="@Localizer["Exercise.ValidationErrorText"]"
     data-correct-message="@Localizer["Exercise.CorrectMessage"]"
     data-correct-message-text="@Localizer["Exercise.CorrectMessageText"]"
     data-wrong-message="@Localizer["Exercise.WrongMessage"]"
     data-wrong-message-text="@Localizer["Exercise.WrongMessageText"]">
</div>

@section Scripts {
    <script src="~/js/Exercises/IntervalMelodico.js?v=1.0.0"></script>
}
