@model AcademiaAuditiva.ViewModels.ExerciseViewModel
@{
    ViewData["Title"] = Localizer[Model.Title].Value;
    ViewData["FiltersPartial"] = "_ExerciseFilters";
    // The names of the intervals by their semitones, 0 (unison) to 12, which SingInterval.js shows.
    var intervalKeys = new[] { "Unison", "2min", "2maj", "3min", "3maj", "4J", "4A", "5J", "6min", "6maj", "7min", "7maj", "8J" };
}

@await Html.PartialAsync("_ExerciseHeader", Model)
<input type="hidden" id="exerciseId" value="@Model.ExerciseId" />

<div class="row g-4">
    <div class="col-lg-8 order-lg-2">
        <section class="aa-panel" aria-labelledby="aa-question">
            <h2 id="aa-question" class="aa-question">@Localizer["Exercise.SingIntervalText"]</h2>
            <p id="singIntervalPrompt" class="aa-sing-prompt" aria-live="polite"></p>

            <div class="aa-audio-row">
                @await Html.PartialAsync("_ExerciseAudioButtons", Model.AudioButtons)
                <div id="waveform" class="aa-wave" aria-hidden="true"></div>
                @await Html.PartialAsync("_MicrophoneControls")
            </div>

            <div class="aa-validate">
                <button type="button" id="validateGuess" class="btn btn-primary px-4">@Localizer["Exercise.ValidationButton"]</button>
            </div>
        </section>
    </div>
    <div class="col-lg-4 order-lg-1">
        @await Html.PartialAsync("_ExerciseInstructions", Model)
    </div>
</div>

@await Html.PartialAsync("_ExerciseFiltersModal", Model)

<div id="intervalNames" hidden>
    @for (var semitones = 0; semitones < intervalKeys.Length; semitones++)
    {
        <span data-semitones="@semitones">@Localizer["Exercise.Interval." + intervalKeys[semitones]]</span>
    }
</div>

<div id="localizer"
     data-incomplete-title="@Localizer["Exercise.IncompleteTitle"]"
     data-incomplete-text="@Localizer["Exercise.Singing.NoRecordingText"]"
     data-one-note-text="@Localizer["Exercise.SingInterval.OneNoteText"]"
     data-no-audio-title="@Localizer["Exercise.NoAudioTitle"]"
     data-no-audio-text="@Localizer["Exercise.NoAudioText"]"
     data-validation-error-title="@Localizer["Exercise.ValidationErrorTitle"]"
     data-validation-error-text="@Localizer["Exercise.ValidationErrorText"]"
     data-correct-message="@Localizer["Exercise.CorrectMessage"]"
     data-correct-message-text="@Localizer["Exercise.CorrectMessageText"]"
     data-wrong-message="@Localizer["Exercise.WrongMessage"]"
     data-wrong-message-text="@Localizer["Exercise.WrongNoteMessageText"]"
     data-heard-text="@Localizer["Exercise.Singing.Heard"]"
     data-heard-interval-text="@Localizer["Exercise.SingInterval.HeardInterval"]"
     data-direction-asc="@Localizer["Exercise.Direction.Asc"]"
     data-direction-desc="@Localizer["Exercise.Direction.Desc"]">
</div>

@section Scripts {
    <script src="~/js/core/pitch-detector.js" asp-append-version="true"></script>
    <script src="~/js/core/singing.js" asp-append-version="true"></script>
    <script src="~/js/Exercises/SingExercise.js" asp-append-version="true"></script>
    <script src="~/js/Exercises/SingInterval.js" asp-append-version="true"></script>
}
