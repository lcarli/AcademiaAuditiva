@{
    ViewData["Title"] = Localizer["Admin.Home.Title"].Value;
    var stats = new (string Label, object Value, string Icon)[] {
        (Localizer["Admin.Users"].Value,      ViewBag.UserCount,      "bi-people"),
        (Localizer["Admin.Admins"].Value,     ViewBag.AdminCount,     "bi-shield-lock"),
        (Localizer["Admin.Teachers"].Value,   ViewBag.TeacherCount,   "bi-mortarboard"),
        (Localizer["Admin.Students"].Value,   ViewBag.StudentCount,   "bi-person-check"),
        (Localizer["Admin.Classrooms"].Value, ViewBag.ClassroomCount, "bi-easel"),
        (Localizer["Admin.Routines"].Value,   ViewBag.RoutineCount,   "bi-list-check"),
    };
}

<header class="mb-4">
    <h1 class="display-6 mb-1 text-body-emphasis">@Localizer["Admin.Home.Title"]</h1>
    <p class="text-secondary mb-0">@Localizer["Admin.Home.Subtitle"]</p>
</header>

<div class="row g-3 g-md-4">
    @foreach (var s in stats)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="aa-card aa-card-accent p-3 p-md-4 h-100">
                <span class="aa-icon-pill mb-3" aria-hidden="true"><i class="bi @s.Icon"></i></span>
                <div class="text-secondary small text-uppercase">@s.Label</div>
                <div class="display-6 mb-0 text-body-emphasis">@s.Value</div>
            </div>
        </div>
    }
</div>
