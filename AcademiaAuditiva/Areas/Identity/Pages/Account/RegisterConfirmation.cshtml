@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = Localizer["Confirmation.Header"];
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <p>
            @Localizer["Confirmation.DevEmailNotice"] <a href="https://aka.ms/aspaccountconf">@Localizer["Confirmation.DevEmailDocs"]</a>.
            @Localizer["Confirmation.DevEmailLinkIntro"] <a id="confirm-link" href="@Model.EmailConfirmationUrl">@Localizer["Confirmation.DevEmailLink"]</a>
        </p>
    }
    else
    {
        <p>
            @Localizer["Confirmation.Text"]
        </p>
    }
}
