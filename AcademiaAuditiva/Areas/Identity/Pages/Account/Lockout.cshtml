@page
@model LockoutModel
@{
    ViewData["Title"] = Localizer["Lockout.Header"].Value;
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">@Localizer["Lockout.Text"]</p>
    <p>@Localizer["Lockout.Wait", Model.LockoutMinutes] <a id="lockout-reset-password" asp-page="./ForgotPassword">@Localizer["Login.Remember"]</a></p>
    <p>@Localizer["Lockout.Contact"] <a href="mailto:contato@academiaauditiva.com">contato@academiaauditiva.com</a></p>
</header>
