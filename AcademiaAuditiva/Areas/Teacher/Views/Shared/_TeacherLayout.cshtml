@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    string ActiveIf(params string[] controllers) =>
        controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}

<div class="row g-4">
    <aside class="col-lg-3 col-xl-2">
        <div class="aa-card-flat p-3 aa-side-sticky">
            <h2 class="aa-eyebrow d-block mb-2 mb-lg-3">@Localizer["Teacher.SidebarTitle"]</h2>
            <nav class="nav flex-row flex-lg-column gap-1 aa-side-nav">
                <a class="nav-link rounded-2 @ActiveIf("Home")" asp-area="Teacher" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>@Localizer["Teacher.Nav.Dashboard"]
                </a>
                <a class="nav-link rounded-2 @ActiveIf("Classrooms", "Dashboard", "Members")" asp-area="Teacher" asp-controller="Classrooms" asp-action="Index">
                    <i class="bi bi-people me-2" aria-hidden="true"></i>@Localizer["Teacher.Nav.Classrooms"]
                </a>
                <a class="nav-link rounded-2 @ActiveIf("Routines")" asp-area="Teacher" asp-controller="Routines" asp-action="Index">
                    <i class="bi bi-list-check me-2" aria-hidden="true"></i>@Localizer["Teacher.Nav.Routines"]
                </a>
            </nav>
        </div>
    </aside>
    <div class="col-lg-9 col-xl-10">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

@* Hand the page's scripts to _Layout, which renders them after jQuery. *@
@section Scripts {
    @RenderSection("Scripts", required: false)
}
