@model AcademiaAuditiva.Areas.Teacher.Models.RoutineOverridesViewModel
@{
    ViewData["Title"] = Localizer["Teacher.Overrides.Title"].Value;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1 text-body-emphasis">@Localizer["Teacher.Overrides.Title"]</h1>
        <p class="text-secondary mb-0">@Model.RoutineName · 👥 @Model.ClassroomName</p>
    </div>
    <a class="btn btn-link btn-sm" asp-action="Details" asp-route-id="@Model.RoutineId">@Localizer["Teacher.Routines.Back"]</a>
</div>
<p class="text-secondary">@Localizer["Teacher.Overrides.Intro"]</p>

<div class="row g-4">
    <div class="col-lg-4">
        <nav class="aa-card-flat" aria-labelledby="ovr-students">
            <div class="card-header bg-transparent border-bottom border-body">
                <strong id="ovr-students" class="text-body-emphasis"><i class="bi bi-people me-1" aria-hidden="true"></i>@Localizer["Teacher.Overrides.Students"] (@Model.Students.Count)</strong>
            </div>
            @if (Model.Students.Count == 0)
            {
                <div class="card-body text-secondary small">@Localizer["Teacher.Overrides.NoStudents"]</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var s in Model.Students)
                    {
                        var isCurrent = s.Id == Model.StudentId;
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 @(isCurrent ? "active" : null)"
                           aria-current="@(isCurrent ? "page" : null)"
                           asp-action="Overrides" asp-route-routineId="@Model.RoutineId" asp-route-assignmentId="@Model.AssignmentId" asp-route-studentId="@s.Id">
                            <span class="text-break">@s.Display</span>
                            @if (s.OverrideCount > 0)
                            {
                                <span class="aa-badge-soft flex-shrink-0">@Localizer["Teacher.Overrides.ItemsCustomized", s.OverrideCount]</span>
                            }
                        </a>
                    }
                </div>
            }
        </nav>
    </div>

    <div class="col-lg-8">
        @if (Model.StudentId == null)
        {
            <div class="aa-card-flat">
                <div class="card-body text-secondary">@Localizer["Teacher.Overrides.ChooseStudent"]</div>
            </div>
        }
        else
        {
            <h2 class="h5 mb-3 text-body-emphasis">@Localizer["Teacher.Overrides.For", Model.StudentDisplay ?? string.Empty]</h2>
            <form asp-action="Overrides" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="RoutineId" />
                <input type="hidden" asp-for="AssignmentId" />
                <input type="hidden" asp-for="StudentId" />

                @if (Model.Items.Count == 0)
                {
                    <p class="text-secondary">@Localizer["Teacher.Routines.NoExercisesYet"]</p>
                }
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    @* Disabled controls aren't posted, so Items.index names the rows that are. *@
                    <fieldset class="aa-card-flat p-3 mb-3" disabled="@item.Started">
                        <legend class="h6 mb-2 float-none w-auto text-body-emphasis">@(i + 1). @item.ExerciseName</legend>
                        @if (item.Started)
                        {
                            <p class="small text-secondary d-flex align-items-start gap-2">
                                <i class="bi bi-lock mt-1" aria-hidden="true"></i>
                                <span>@Localizer["Teacher.Overrides.Started"]</span>
                            </p>
                        }
                        else
                        {
                            <input type="hidden" name="Items.index" value="@i" />
                        }
                        <input type="hidden" asp-for="Items[i].ItemId" />
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Items[i].Exclude" />
                            <label class="form-check-label" asp-for="Items[i].Exclude"></label>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" asp-for="Items[i].TargetCount"></label>
                                <input class="form-control" asp-for="Items[i].TargetCount" type="number" min="1" max="100" placeholder="@item.DefaultTarget" />
                                <div class="form-text">@Localizer["Teacher.Overrides.RoutineSetting", item.DefaultTarget]</div>
                                <span class="text-danger small" asp-validation-for="Items[i].TargetCount"></span>
                            </div>
                            @foreach (var group in item.FilterGroups)
                            {
                                var selectId = $"o-{i}-{group.Name}";
                                item.Filters.TryGetValue(group.Name, out var current);
                                item.DefaultFilters.TryGetValue(group.Name, out var routineValue);
                                var routineOption = group.Options.FirstOrDefault(o => o.Value == routineValue);
                                var routineText = routineOption != null
                                    ? Localizer[routineOption.Text].Value
                                    : Localizer["Teacher.Routines.Filters.StudentChooses"].Value;
                                <div class="col-md-4">
                                    <label class="form-label" for="@selectId">@Localizer[group.Label]</label>
                                    <select class="form-select" id="@selectId" name="Items[@i].Filters[@group.Name]">
                                        <option value="">@Localizer["Teacher.Overrides.RoutineSetting", routineText]</option>
                                        @foreach (var opt in group.Options)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == current)">@Localizer[opt.Text]</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </fieldset>
                }

                @if (Model.Items.Any(x => !x.Started))
                {
                    <button type="submit" class="btn btn-primary">@Localizer["Common.Save"]</button>
                }
            </form>

            @if (Model.CanClear)
            {
                var clearConfirm = Model.KeepsStarted ? "Teacher.Overrides.ClearStartedConfirm" : "Teacher.Overrides.ClearConfirm";
                <form asp-action="ClearOverrides" method="post" class="mt-3"
                      data-confirm="@Localizer[clearConfirm].Value"
                      onsubmit="return confirm(this.dataset.confirm);">
                    <input type="hidden" name="routineId" value="@Model.RoutineId" />
                    <input type="hidden" name="assignmentId" value="@Model.AssignmentId" />
                    <input type="hidden" name="studentId" value="@Model.StudentId" />
                    <button type="submit" class="btn btn-link text-danger px-0">
                        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>@Localizer["Teacher.Overrides.Clear"]
                    </button>
                </form>
            }
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
