@model AcademiaAuditiva.Areas.Teacher.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = $"{Localizer["Teacher.Nav.Dashboard"].Value} — {Model.Display}";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Display</h1>
        <div class="text-secondary">@Model.Email</div>
        <div class="small text-secondary">
            @foreach (var c in Model.Classrooms) { <span class="aa-badge-soft me-1">@c.Name</span> }
        </div>
    </div>
    <div>
        @if (Model.BackClassroomId.HasValue)
        {
            <a class="btn btn-link" asp-action="Classroom" asp-route-id="@Model.BackClassroomId">@Localizer["Teacher.Dashboard.BackToClassroom"]</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.Sessions"]</div>
            <div class="h3 mb-0">@Model.TotalSessions.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.Attempts"]</div>
            <div class="h3 mb-0">@Model.TotalAttempts.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.Accuracy"]</div>
            <div class="h3 mb-0">@Localizer["Common.Percent", Model.OverallAccuracy.ToString("F1")]</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Dashboard.LastActivity"]</div>
            <div class="h5 mb-0">
                @if (Model.LastActivity.HasValue) { @Model.LastActivity.Value.ToString("yyyy-MM-dd HH:mm") }
                else { <span class="text-secondary">@Localizer["Teacher.Dashboard.Never"]</span> }
            </div>
        </div></div>
    </div>
</div>

<div class="aa-card-flat">
    <div class="card-header bg-transparent border-bottom border-body"><strong>@Localizer["Teacher.Dashboard.ByExercise"]</strong></div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Dashboard.Exercise"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Attempts"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Accuracy"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Best"]</th>
                    <th>@Localizer["Dashboard.LastActivity"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.ByExercise)
            {
                <tr>
                    <td>@r.ExerciseName</td>
                    <td class="text-end">@r.Attempts.ToString("N0")</td>
                    <td class="text-end">@Localizer["Common.Percent", r.Accuracy.ToString("F1")]</td>
                    <td class="text-end">@r.BestScore</td>
                    <td>@r.LastActivity.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            @if (!Model.ByExercise.Any())
            {
                <tr><td colspan="5" class="text-secondary text-center py-4">@Localizer["Teacher.Dashboard.StudentNoPractice"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
