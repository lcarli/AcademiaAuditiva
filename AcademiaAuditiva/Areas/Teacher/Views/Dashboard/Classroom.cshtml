@model AcademiaAuditiva.Areas.Teacher.Models.ClassroomDashboardViewModel
@{
    ViewData["Title"] = $"{Localizer["Teacher.Dashboard.Classroom"].Value} — {Model.ClassroomName}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.ClassroomName</h1>
        <small class="text-secondary">@Localizer["Teacher.Dashboard.Classroom"]</small>
    </div>
    <a class="btn btn-link" asp-controller="Classrooms" asp-action="Details" asp-route-id="@Model.ClassroomId">
        @Localizer["Teacher.Dashboard.BackToClassroom"]
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Admin.Students"]</div>
            <div class="h3 mb-0">@Model.Rows.Count</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.Active30d"]</div>
            <div class="h3 mb-0">@Model.ActiveStudentsLast30Days</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.TotalAttempts"]</div>
            <div class="h3 mb-0">@Model.TotalAttempts.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="aa-card-flat h-100"><div class="card-body">
            <div class="text-secondary small">@Localizer["Teacher.Dashboard.AvgAccuracy"]</div>
            <div class="h3 mb-0">@Model.AverageAccuracy.ToString("F1")%</div>
        </div></div>
    </div>
</div>

<div class="aa-card-flat">
    <div class="card-header bg-transparent border-bottom border-body"><strong>@Localizer["Teacher.Dashboard.PerStudent"]</strong></div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Admin.Students"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Sessions"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Attempts"]</th>
                    <th class="text-end">@Localizer["Teacher.Dashboard.Accuracy"]</th>
                    <th>@Localizer["Dashboard.LastActivity"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>
                        <div>@r.Display</div>
                        <small class="text-secondary">@r.Email</small>
                    </td>
                    <td class="text-end">@r.Sessions</td>
                    <td class="text-end">@r.Attempts.ToString("N0")</td>
                    <td class="text-end">@r.Accuracy.ToString("F1")%</td>
                    <td>
                        @if (r.LastActivity.HasValue) { @r.LastActivity.Value.ToString("yyyy-MM-dd HH:mm") }
                        else { <span class="text-secondary">@Localizer["Teacher.Dashboard.Never"]</span> }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Student" asp-route-id="@r.StudentId" asp-route-classroomId="@Model.ClassroomId">@Localizer["Teacher.Dashboard.View"]</a>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="6" class="text-secondary text-center py-4">@Localizer["Teacher.Dashboard.NoStudents"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
